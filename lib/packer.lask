// Packer.

import { ToolSetup, in_cache, layered_env, layered_volumes, mount, prefixed, vars } from "./common.lask"

// Packer, configured by its parameters.
//
// The image is #hashicorp/packer:1.16.1 unless --image names another.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// Packer does not call home (CHECKPOINT_DISABLE=1). A builder's
// credentials come in through --with: aws_setup for amazon-ebs,
// gcloud_setup for googlecompute, azure_setup for azure-arm.
//
// @param image        The image to run; another release is passed as image = #hashicorp/packer:<tag>.
// @param log          PACKER_LOG, "1" for a verbose log.
// @param variables    Input variables, each set as PKR_VAR_<name>.
// @param cache_dir    Host directory mounted at /cache; plugins go in /cache/plugins (PACKER_PLUGIN_PATH) and downloads in /cache/packer_cache (PACKER_CACHE_DIR).
// @param base_access  What the container may do with the project directory: "rw" (the default), "ro", "none", or a table of paths such as {".": "ro", "dist": "rw"} (lask spec 10.2).
// @param egress       The only destinations, as <host>:<port>, the container may reach, through Lask's proxy (lask spec 10.12); null leaves the network as it is.
// @param with         Setups of other tools this environment should also carry: a builder's credentials.
// @param extra_env    Any other variable; below --with and the named parameters.
// @return The environment, for `command { "packer" } on ...` or `$[...]`.
// @example lask eval packer.env --variables '{"region": "ap-northeast-1"}'
env(
  --image: Environment = #hashicorp/packer:1.16.1,
  --log: String | Null = null,
  --variables: Map<String> = {},
  --cache_dir: String | Null = null,
  --base_access: String | Map<String> | Null = null,
  --egress: Array<String> | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"CHECKPOINT_DISABLE": "1"},
    extra_env,
    with,
    merge(prefixed("PKR_VAR_", variables), vars({
      "PACKER_LOG": log,
      "PACKER_PLUGIN_PATH": in_cache(cache_dir, "plugins"),
      "PACKER_CACHE_DIR": in_cache(cache_dir, "packer_cache")
    }))
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache")),
  base_access = base_access,
  egress = egress
)
