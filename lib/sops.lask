// SOPS, encrypted files.

import { ToolSetup, given, layered_env, layered_volumes, mount, vars } from "./common.lask"

// SOPS, ghcr.io/getsops/sops:v3.13.3-alpine by default.
//
// An age key is given here; a cloud KMS key takes that cloud's setup
// through --with: aws_setup, gcloud_setup, azure_setup, vault_setup.
//
// @param image         The image to run; another release is passed as image = #ghcr.io/getsops/sops:<tag>.
// @param age_key       SOPS_AGE_KEY, the private key itself; masked in the command log.
// @param age_key_file  Host path of an age key file, mounted read-only at /run/secrets/age-key.txt (SOPS_AGE_KEY_FILE).
// @param with          Setups of other tools this environment should also carry: a KMS's credentials.
// @param extra_env     Any other variable; below --with and the named parameters.
// @return The environment, for `command { "sops" } on ...` or `$[...]`.
// @example lask eval sops.env --age_key_file /home/me/.config/sops/age/keys.txt
env(
  --image: Environment = #ghcr.io/getsops/sops:v3.13.3-alpine,
  --age_key!!: String | Null = null,
  --age_key_file: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {},
    extra_env,
    with,
    vars({"SOPS_AGE_KEY": age_key, "SOPS_AGE_KEY_FILE": given(age_key_file, "/run/secrets/age-key.txt")})
  ),
  volumes = layered_volumes(with, mount(age_key_file, "/run/secrets/age-key.txt:ro"))
)
