    "config locations": { closed: true, options: [{ names: ["--all"], description: "include every file extension supported" }, { names: ["-h", "--help"], description: "help for locations" }, { names: ["-c", "--config"], value: "required", description: "grype configuration file(s) to use" }, { names: ["--profile"], value: "required", description: "configuration profiles to use" }, { names: ["-q", "--quiet"], description: "suppress all logging output" }, { names: ["-v", "--verbose"], value: "required", description: "increase verbosity (-v = info, -vv = debug)" }], description: "shows all locations and the order in which grype will look for a configuration file" },
    "db": { closed: true, options: [{ names: ["-h", "--help"], description: "help for db" }, { names: ["-c", "--config"], value: "required", description: "grype configuration file(s) to use" }, { names: ["--profile"], value: "required", description: "configuration profiles to use" }, { names: ["-q", "--quiet"], description: "suppress all logging output" }, { names: ["-v", "--verbose"], value: "required", description: "increase verbosity (-v = info, -vv = debug)" }], description: "vulnerability database operations" },
