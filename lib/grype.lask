// Grype, Anchore's vulnerability scanner.

import { ToolSetup, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// Grype, Anchore's vulnerability scanner.
//
// Anchore's images have no shell, so the image is built from
// lib/images/anchore/Dockerfile, which copies grype v0.119.0 and syft
// v1.52.0 onto Alpine: it takes no --image, and `lask sync` builds it.
// Grype checks for no update (GRYPE_CHECK_FOR_APP_UPDATE=false).
//
// Without --cache_dir, every run downloads the vulnerability database.
//
// @param cache_dir  Host directory mounted at /cache; the database is kept in /cache/grype (GRYPE_DB_CACHE_DIR).
// @param with       Setups of other tools this environment should also carry: registry_setup, docker_setup.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "grype" } on ...` or `$[...]`.
// @example lask eval grype.env --cache_dir /tmp/cache
env(
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = #./images/anchore/Dockerfile{
  env: layered_env(
    {"GRYPE_CHECK_FOR_APP_UPDATE": "false"},
    extra_env,
    with,
    vars({"GRYPE_DB_CACHE_DIR": in_cache(cache_dir, "grype")})
  ),
  volumes: layered_volumes(with, mount(cache_dir, "/cache"))
}

command { "grype" } on env() schema schema

// The command schema of grype 0.119.0, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal grype_command: CommandSchema = {
  root: {
    closed: true,
    subcommand_optional: true,
    options: [
      { names: ["--add-cpes-if-none"], description: "generate CPEs for packages with no CPE data" },
      { names: ["--by-cve"], description: "orient results by CVE instead of the original vulnerability ID when possible" },
      { names: ["-c", "--config"], value: "required", description: "grype configuration file(s) to use" },
      { names: ["--distro"], value: "required", description: "distro to match against in the format: <distro>[-:@]<version>" },
      { names: ["--exclude"], value: "required", description: "exclude paths from being scanned using a glob expression" },
      { names: ["-f", "--fail-on"], value: "required", description: "set the return code to 2 if a vulnerability is found with a severity >= the given severity, options=[negligible low medium high critical]" },
      { names: ["--file"], value: "required", description: "file to write the default report output to (default is STDOUT)" },
      { names: ["--from"], value: "required", description: "specify the source behavior to use (e.g" },
      { names: ["-h", "--help"], description: "help for grype" },
      { names: ["--ignore-states"], value: "required", description: "ignore matches for vulnerabilities with specified comma separated fix states, options=[fixed not-fixed unknown wont-fix]" },
      { names: ["--name"], value: "required", description: "set the name of the target being analyzed" },
      { names: ["--only-fixed"], description: "ignore matches for vulnerabilities that are not fixed" },
      { names: ["--only-notfixed"], description: "ignore matches for vulnerabilities that are fixed" },
      { names: ["-o", "--output"], value: "required", description: "report output formatter, formats=[json table cyclonedx cyclonedx-json sarif template], deprecated formats=[embedded-cyclonedx-vex-json embed" },
      { names: ["--platform"], value: "required", description: "an optional platform specifier for container image sources (e.g" },
      { names: ["--profile"], value: "required", description: "configuration profiles to use" },
      { names: ["-q", "--quiet"], description: "suppress all logging output" },
      { names: ["-s", "--scope"], value: "required", description: "selection of layers to analyze, options=[squashed all-layers deep-squashed] (default \"squashed\")" },
      { names: ["--show-suppressed"], description: "show suppressed/ignored vulnerabilities in the output (only supported with table output format)" },
      { names: ["--sort-by"], value: "required", description: "sort the match results with the given strategy, options=[package severity epss risk kev vulnerability] (default \"risk\")" },
      { names: ["-t", "--template"], value: "required", description: "specify the path to a Go template file (requires 'template' output to be selected)" },
      { names: ["-v", "--verbose"], value: "required", description: "increase verbosity (-v = info, -vv = debug)" },
