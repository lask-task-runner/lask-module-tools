// Terraform.

import { ToolSetup, layered_env, layered_volumes, mount, tf_env } from "./common.lask"

// Terraform, configured by its parameters.
//
// The image is #hashicorp/terraform:1.16.4 unless --image names another.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// Nothing waits on a prompt (TF_INPUT=0), and Terraform leaves out the
// hints it gives a person at a terminal (TF_IN_AUTOMATION=1). A
// provider's credentials come in through --with: the AWS provider takes
// `with = [aws.setup(...)]`. Secrets for input variables go through
// --variables as TF_VAR_* variables of the container, never on the command
// line; bind them with `!!` where they come from, and they are masked.
//
// @param image      The image to run; another release is passed as image = #hashicorp/terraform:<tag>.
// @param workspace  TF_WORKSPACE.
// @param log        TF_LOG, e.g. "DEBUG".
// @param variables  Input variables, each set as TF_VAR_<name>.
// @param cache_dir  Host directory mounted at /cache and used as the plugin cache itself (TF_PLUGIN_CACHE_DIR), e.g. home(".terraform.d/plugin-cache"). `terraform init` reports an error for a cache directory that does not exist yet, so the cache is the mount point, which always does.
// @param with       Setups of other tools this environment should also carry: a provider's credentials.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "terraform" } on ...` or `$[...]`.
// @example lask eval terraform.env --workspace staging
env(
  --image: Environment = #hashicorp/terraform:1.16.4,
  --workspace: String | Null = null,
  --log: String | Null = null,
  --variables: Map<String> = {},
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"TF_IN_AUTOMATION": "1", "TF_INPUT": "0"},
    extra_env,
    with,
    tf_env(workspace, log, variables, cache_dir)
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)
