// Deno.

import { ToolSetup, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// Deno, configured by its parameters.
//
// The image is #denoland/deno:alpine-2.9.7 unless --image names another.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// Deno checks for no update and never prompts for a permission
// (DENO_NO_UPDATE_CHECK=1, DENO_NO_PROMPT=1): a permission not granted
// on the command line fails.
//
// @param image        The image to run; another release is passed as image = #denoland/deno:<tag>.
// @param auth_tokens  DENO_AUTH_TOKENS, for private modules; masked in the command log.
// @param cache_dir    Host directory mounted at /cache; Deno's cache is /cache/deno (DENO_DIR).
// @param with         Setups of other tools this environment should also carry.
// @param extra_env    Any other variable; below --with and the named parameters.
// @return The environment, for `command { "deno" } on ...` or `$[...]`.
// @example lask eval deno.env --cache_dir /tmp/cache
env(
  --image: Environment = #denoland/deno:alpine-2.9.7,
  --auth_tokens!!: String | Null = null,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"DENO_NO_UPDATE_CHECK": "1", "DENO_NO_PROMPT": "1"},
    extra_env,
    with,
    vars({"DENO_AUTH_TOKENS": auth_tokens, "DENO_DIR": in_cache(cache_dir, "deno")})
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

// Deno and Bun work as they are, so their command words are exported.
command { "deno" } on env() schema schema

// The command schema of deno 2.9.7, read from its help and checked against
// the program: every option it lists is one the program accepts.
