// The command schema of stack 3.11.1, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal stack_command: CommandSchema = {
  root: {
    closed: true,
    options: [
      { names: ["-h", "--help"], value: "optional", global: true, description: "Show this help text" },
      { names: ["--version"], value: "optional", global: true, description: "Show version" },
      { names: ["--numeric-version"], value: "optional", global: true, description: "Show only version number" },
      { names: ["--hpack-numeric-version"], value: "optional", global: true, description: "Show only Hpack's version number" },
      { names: ["--verbosity"], value: "required", global: true, description: "Set verbosity level: silent, error, warn, info or debug" },
      { names: ["-v", "--verbose"], global: true, description: "Enable verbose mode: verbosity level \"debug\"" },
      { names: ["--silent"], global: true, description: "Enable silent mode: verbosity level \"silent\"" },
      { names: ["--time-in-log", "--no-time-in-log"], global: true, description: "Enable/disable inclusion of timings in logs, for the purposes of using diff with logs" },
      { names: ["--rsl-in-log", "--no-rsl-in-log"], global: true, description: "Enable/disable inclusion of raw snapshot layer (rsl) in logs" },
      { names: ["--plan-in-log", "--no-plan-in-log"], global: true, description: "Enable/disable inclusion of information about build plan construction in logs" },
      { names: ["--stack-root"], value: "required", global: true, description: "Absolute path to the global Stack root directory" },
      { names: ["--work-dir"], value: "required", global: true, description: "Relative path to Stack's work directory" },
      { names: ["--system-ghc", "--no-system-ghc"], global: true, description: "Enable/disable using the system installed GHC (on the PATH) if it is available and its version matches" },
      { names: ["--install-ghc", "--no-install-ghc"], global: true, description: "Enable/disable downloading and installing GHC if necessary" },
      { names: ["--install-msys", "--no-install-msys"], global: true, description: "Enable/disable downloading and installing MSYS2 if necessary (Windows only)" },
      { names: ["--arch"], value: "required", global: true, description: "System architecture, e.g" },
      { names: ["--ghc-variant"], value: "required", global: true, description: "Specialized GHC variant, e.g" },
      { names: ["--ghc-build"], value: "required", global: true, description: "Specialized GHC build, e.g" },
      { names: ["-j", "--jobs"], value: "required", global: true, description: "Number of concurrent jobs to run" },
      { names: ["--extra-include-dirs"], value: "required", global: true },
      { names: ["--extra-lib-dirs"], value: "required", global: true, description: "Extra directories to check for libraries" },
      { names: ["--custom-preprocessor-extensions"], value: "required", global: true, description: "Extensions used for custom preprocessors" },
      { names: ["--with-gcc"], value: "required", global: true, description: "Use gcc found at PATH-TO-GCC" },
      { names: ["--with-hpack"], value: "required", global: true, description: "Use HPACK executable (overrides bundled Hpack)" },
      { names: ["--hpack-force", "--no-hpack-force"], global: true, description: "Enable/disable overwriting of Cabal files that were created by a more recent version of Hpack or have been modified manually" },
      { names: ["--skip-ghc-check", "--no-skip-ghc-check"], global: true, description: "Enable/disable skipping the GHC version and architecture check" },
      { names: ["--skip-msys", "--no-skip-msys"], global: true, description: "Enable/disable skipping the local MSYS installation (Windows only)" },
      { names: ["--local-bin-path"], value: "required", global: true, description: "Override the target directory for 'stack build --copy-bins' and 'stack install'. DIR can be an absolute path or one relative to the current " },
      { names: ["--setup-info-yaml"], value: "required", global: true, description: "Alternate URL or path (relative or absolute) for Stack dependencies" },
      { names: ["--modify-code-page", "--no-modify-code-page"], global: true, description: "Enable/disable setting the codepage to support UTF-8 (Windows only)" },
      { names: ["--allow-different-user", "--no-allow-different-user"], global: true, description: "Enable/disable permission for users other than the owner of the Stack root directory to use a Stack installation (POSIX only)" },
      { names: ["--dump-logs", "--no-dump-logs"], global: true, description: "Enable/disable dump the build output logs for project packages to the console" },
      { names: ["--color", "--colour"], value: "required", global: true, description: "Specify when to use color in output; WHEN is 'always', 'never', or 'auto'. On Windows versions before Windows 10, for terminals that do not " },
      { names: ["--snapshot-location-base"], value: "required", global: true, description: "The base location of LTS/Nightly snapshots" },
      { names: ["--script-no-run-compile", "--no-script-no-run-compile"], global: true, description: "Enable/disable the use of options `--no-run --compile` with `stack script`. (default: disabled)" },
      { names: ["--resolver", "--snapshot"], value: "required", global: true, description: "Override snapshot in the project configuration file" },
      { names: ["--compiler"], value: "required", global: true, description: "Use the specified compiler" },
      { names: ["--terminal", "--no-terminal"], global: true, description: "Enable/disable overriding terminal detection in the case of running in a false terminal" },
      { names: ["--stack-colors", "--stack-colours"], value: "required", global: true, description: "Specify Stack's output styles; STYLES is a colon-delimited sequence of key=value, where 'key' is a style name and 'value' is a semicolon-del" },
      { names: ["--terminal-width"], value: "required", global: true, description: "Specify the width of the terminal, used for pretty-print messages" },
      { names: ["-w", "--stack-yaml"], value: "required", global: true, description: "Override project stack.yaml file (overrides any STACK_YAML environment variable)" },
      { names: ["--lock-file"], value: "required", global: true, description: "Specify how to interact with lock files" }
    ]
  },
  subcommands: {
