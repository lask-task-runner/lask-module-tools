// The command schemas of ghc, ghci, cabal, stack (lask spec ch. 5) for GHC 9.12.4,
// the release in env()'s default image.
schema_9_12_4: Map<CommandSchema> = { "ghc": ghc_command, "ghci": ghc_command, "cabal": cabal_command, "stack": stack_command }

// The command schemas of the release in env()'s default image: the
// ones a command string that runs these words is checked against.
schema: Map<CommandSchema> = schema_9_12_4
