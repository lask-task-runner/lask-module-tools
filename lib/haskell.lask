// The command schema of cabal 3.14.1, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal cabal_command: CommandSchema = {
  root: {
    closed: true,
    abbreviations: true,
    options: [
      { names: ["-h", "--help"], description: "Show this help text" },
      { names: ["-V", "--version"], description: "Print version information" },
      { names: ["--numeric-version"], description: "Print just the version number" },
      { names: ["--config-file"], value: "required", description: "Set an alternate location for the config file" },
      { names: ["--ignore-expiry"], description: "Ignore expiry dates on signed metadata (use only in exceptional circumstances)" },
      { names: ["--http-transport"], value: "required", description: "Set a transport for http(s) requests" },
      { names: ["--nix"], value: "optional", description: "[DEPRECATED] Nix integration: run commands through nix-shell if a 'shell.nix' file exists (default is False)" },
