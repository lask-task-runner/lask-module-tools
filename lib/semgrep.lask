      { names: ["--error"], value: "optional", description: "Exit 1 if there are findings" },
      { names: ["--exclude"], value: "required", description: "Skip any file or directory whose path that matches PATTERN. '--exclude=*.py' will ignore the following: 'foo.py', 'src/foo.py', 'foo.py/bar." },
