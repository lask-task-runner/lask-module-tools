      { names: ["-d", "--dump-command-for-core"], value: "optional", description: "<internal, do not use>" },
      { names: ["--dataflow-traces"], value: "optional", description: "Explain how non-local values reach the location of a finding (only affects text and SARIF output)" },
      { names: ["--disable-nosem"], value: "optional", description: "negates --enable-nosem" },
