      { names: ["--dump-ast"], value: "optional", description: "If --dump-ast, shows AST of the input file or passed expression and then exit (can use --json)" },
      { names: ["--dump-engine-path"], value: "optional", description: "<internal, do not use>" },
      { names: ["-e", "--pattern"], value: "required", description: "Code search pattern" },
      { names: ["--emacs"], value: "optional", description: "Output results in Emacs single-line format" },
