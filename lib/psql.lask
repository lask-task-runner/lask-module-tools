// psql, the PostgreSQL client, and what libpq reads to reach a server.

import { ToolSetup, layered_env, layered_volumes, vars } from "./common.lask"

// What libpq and the clients built on it read to reach a PostgreSQL
// server: psql and pg_dump, psycopg, node-postgres, and most others.
// Give it to an application's environment through --with.
//
// @param host      PGHOST.
// @param port      PGPORT.
// @param user      PGUSER.
// @param password  PGPASSWORD; masked in the command log.
// @param database  PGDATABASE.
// @param sslmode   PGSSLMODE, e.g. "require".
// @return The variables, for a tool's --with.
setup(
  --host: String | Null = null,
  --port: String | Null = null,
  --user: String | Null = null,
  --password!!: String | Null = null,
  --database: String | Null = null,
  --sslmode: String | Null = null
): ToolSetup = {
  env: vars({
    "PGHOST": host,
    "PGPORT": port,
    "PGUSER": user,
    "PGPASSWORD": password,
    "PGDATABASE": database,
    "PGSSLMODE": sslmode
  }),
  volumes: []
}

// psql, pg_dump and the other PostgreSQL clients.
//
// The image is #postgres:18.6-alpine3.24 unless --image names another; use
// the major release of the server. `lask sync` pulls and pins whichever
// image is used (lask spec 10.3); a run never pulls.
//
// @param image      The image to run; another release is passed as image = #postgres:<tag>.
// @param host       PGHOST.
// @param port       PGPORT.
// @param user       PGUSER.
// @param password   PGPASSWORD; masked in the command log.
// @param database   PGDATABASE.
// @param sslmode    PGSSLMODE.
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "psql" } on ...` or `$[...]`.
// @example lask eval psql.env --host host.docker.internal --user app --database app
env(
  --image: Environment = #postgres:18.6-alpine3.24,
  --host: String | Null = null,
  --port: String | Null = null,
  --user: String | Null = null,
  --password!!: String | Null = null,
  --database: String | Null = null,
  --sslmode: String | Null = null,
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = do {
  own = setup(host = host, port = port, user = user, password = password, database = database, sslmode = sslmode)
  runnable(image,
    env = layered_env({}, extra_env, with, own.env),
    volumes = layered_volumes(with, []),
    network = network
  )
}
