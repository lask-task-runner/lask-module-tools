// OpenTofu, configured by the parameters of terraform.

import { ToolSetup, layered_env, layered_volumes, mount, tf_env } from "./common.lask"

// OpenTofu, configured by the parameters of terraform.
//
// The image is #ghcr.io/opentofu/opentofu:1.12.6 unless --image names
// another. OpenTofu reads Terraform's variables, so every parameter means
// what it means for terraform: TF_INPUT=0, TF_IN_AUTOMATION=1, TF_VAR_*
// from --variables, the plugin cache at the /cache mount point.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// @param image      The image to run; another release is passed as image = #ghcr.io/opentofu/opentofu:<tag>.
// @param workspace  TF_WORKSPACE.
// @param log        TF_LOG, e.g. "DEBUG".
// @param variables  Input variables, each set as TF_VAR_<name>.
// @param cache_dir  Host directory mounted at /cache and used as the plugin cache itself (TF_PLUGIN_CACHE_DIR).
// @param with       Setups of other tools this environment should also carry: a provider's credentials.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "tofu" } on ...` or `$[...]`.
// @example lask eval tofu.env --workspace staging
env(
  --image: Environment = #ghcr.io/opentofu/opentofu:1.12.6,
  --workspace: String | Null = null,
  --log: String | Null = null,
  --variables: Map<String> = {},
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"TF_IN_AUTOMATION": "1", "TF_INPUT": "0"},
    extra_env,
    with,
    tf_env(workspace, log, variables, cache_dir)
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)
