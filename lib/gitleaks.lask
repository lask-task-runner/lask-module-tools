// Gitleaks, secrets in a Git history or a tree.

import { ToolSetup, git_trust, layered_env, layered_volumes } from "./common.lask"

// Gitleaks, zricethezav/gitleaks:v8.30.1 by default: secrets in the
// project's files and Git history. The mounted project is trusted by
// Git (safe.directory), so its history can be read.
//
// @param image      The image to run; another release is passed as image = #zricethezav/gitleaks:<tag>.
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with.
// @return The environment, for `command { "gitleaks" } on ...` or `$[...]`.
// @example lask eval gitleaks.env
env(
  --image: Environment = #zricethezav/gitleaks:v8.30.1,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(git_trust(), extra_env, with, {}),
  volumes = layered_volumes(with, [])
)

command { "gitleaks" } on env() schema schema

// The command schema of gitleaks 8.30.1, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal gitleaks_command: CommandSchema = {
  root: {
    closed: true,
    options: [
      { names: ["-b", "--baseline-path"], value: "required", description: "path to baseline with issues that can be ignored" },
      { names: ["-c", "--config"], value: "required", description: "config file path order of precedence: 1" },
      { names: ["--diagnostics"], value: "required", description: "enable diagnostics (http OR comma-separated list: cpu,mem,trace)" },
      { names: ["--diagnostics-dir"], value: "required", description: "directory to store diagnostics output files when not using http mode (defaults to current directory)" },
      { names: ["--enable-rule"], value: "required", description: "only enable specific rules by id" },
      { names: ["--exit-code"], value: "required", description: "exit code when leaks have been encountered (default 1)" },
      { names: ["-i", "--gitleaks-ignore-path"], value: "required", description: "path to .gitleaksignore file or folder containing one (default \".\")" },
      { names: ["-h", "--help"], description: "help for gitleaks" },
      { names: ["--ignore-gitleaks-allow"], description: "ignore gitleaks:allow comments" },
      { names: ["-l", "--log-level"], value: "required", description: "log level (trace, debug, info, warn, error, fatal) (default \"info\")" },
      { names: ["--max-archive-depth"], value: "required", description: "allow scanning into nested archives up to this depth (default \"0\", no archive traversal is done)" },
      { names: ["--max-decode-depth"], value: "required", description: "allow recursive decoding up to this depth (default 5)" },
      { names: ["--max-target-megabytes"], value: "required", description: "files larger than this will be skipped" },
      { names: ["--no-banner"], description: "suppress banner" },
      { names: ["--no-color"], description: "turn off color for verbose output" },
      { names: ["--redact"], description: "redact secrets from logs and stdout" },
      { names: ["-f", "--report-format"], value: "required", description: "output format (json, csv, junit, sarif, template)" },
      { names: ["-r", "--report-path"], value: "required", description: "report file (use \"-\" for stdout)" },
      { names: ["--report-template"], value: "required", description: "template file used to generate the report (implies --report-format=template)" },
      { names: ["--timeout"], value: "required", description: "set a timeout for gitleaks commands in seconds (default \"0\", no timeout is set)" },
      { names: ["-v", "--verbose"], description: "show verbose output from scan" },
      { names: ["--version"], description: "version for gitleaks" }
    ]
  },
