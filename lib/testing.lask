// API, HTTP and load testing: k6, grpcurl, Newman, Robot Framework and
// ApacheBench. Each needs nothing from the caller, so each exports its
// command word.
//
// An image taken at --tag is a reference built when the function runs:
// `lask env build` does not pull or pin it (lask spec 10.3), so pull it
// once, and a run never pulls. A server on the host is at
// host.docker.internal from a container with Docker Desktop, and at
// localhost with network = "host"; a server in a Compose project is on
// that project's network, which --network joins.

import { vars, layered_env, layered_volumes, ToolSetup } from "./common.lask"

// k6 at --tag, grafana/k6:1.8.1 by default. It sends no usage report
// (K6_NO_USAGE_REPORT=true). The image runs as the user k6, not root.
//
// @param tag          The grafana/k6 image tag to run.
// @param cloud_token  K6_CLOUD_TOKEN, for Grafana Cloud k6; masked in the command log.
// @param network      The container's network: a Compose network, or "host".
// @param with         Setups of other tools this environment should also carry.
// @param extra_env    Any other variable, e.g. a value the script reads through __ENV; below --with and the named parameters.
// @return The environment, for `command { "k6" } on ...` or `$[...]`.
// @example lask eval k6 --network host
k6(
  --tag: String = "1.8.1",
  --cloud_token!!: String | Null = null,
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Environment = #docker(
  "grafana/k6:#{tag}",
  env = layered_env({"K6_NO_USAGE_REPORT": "true"}, extra_env, with, vars({"K6_CLOUD_TOKEN": cloud_token})),
  volumes = layered_volumes(with, []),
  network = network
)

// grpcurl at --tag, fullstorydev/grpcurl:v1.9.3-alpine by default.
//
// @param tag        The fullstorydev/grpcurl image tag to run.
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with.
// @return The environment, for `command { "grpcurl" } on ...` or `$[...]`.
// @example lask eval grpcurl --network host
grpcurl(
  --tag: String = "v1.9.3-alpine",
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Environment = #docker(
  "fullstorydev/grpcurl:#{tag}",
  env = layered_env({}, extra_env, with, {}),
  volumes = layered_volumes(with, []),
  network = network
)

// Newman, Postman's collection runner, at --tag,
// postman/newman:6.1.3-alpine by default.
//
// @param tag        The postman/newman image tag to run.
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with.
// @return The environment, for `command { "newman" } on ...` or `$[...]`.
// @example lask eval newman
newman(
  --tag: String = "6.1.3-alpine",
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Environment = #docker(
  "postman/newman:#{tag}",
  env = layered_env({}, extra_env, with, {}),
  volumes = layered_volumes(with, []),
  network = network
)

// Robot Framework, with RequestsLibrary for API tests.
//
// There is no official image, so the image is built from
// lib/images/robot/Dockerfile: Robot Framework 7.5 and RequestsLibrary
// 0.9.7 on the Python image of python(). It has no --tag, and `lask env
// build` (or `lask deps sync`) builds it. Another library is installed
// in the same command, `pip install -r requirements.txt && robot
// tests`; a browser library is better served by playwright().
//
// @param options    ROBOT_OPTIONS, which robot reads before its command line, e.g. "--outputdir results".
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "robot" } on ...` or `$[...]`.
// @example lask eval robot --options "--outputdir results"
robot(
  --options: String | Null = null,
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Environment = #docker(
  dockerfile = "images/robot/Dockerfile",
  env = layered_env({"PYTHONUNBUFFERED": "1"}, extra_env, with, vars({"ROBOT_OPTIONS": options})),
  volumes = layered_volumes(with, []),
  network = network
)

// ApacheBench at --tag, from the Apache HTTP Server image,
// httpd:2.4.68-alpine3.24 by default.
//
// @param tag        The httpd image tag to run.
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with.
// @return The environment, for `command { "ab" } on ...` or `$[...]`.
// @example lask eval ab --network host
ab(
  --tag: String = "2.4.68-alpine3.24",
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Environment = #docker(
  "httpd:#{tag}",
  env = layered_env({}, extra_env, with, {}),
  volumes = layered_volumes(with, []),
  network = network
)

command { "k6" } on k6()
command { "grpcurl" } on grpcurl()
command { "newman" } on newman()
command { "robot", "rebot", "libdoc" } on robot()
command { "ab" } on ab()
