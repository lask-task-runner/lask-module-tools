// Python, with pip.

import { ToolSetup, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// Python, configured by its parameters.
//
// The image is #python:3.12.14-alpine3.24 unless --image names another.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// Output reaches the command log as it happens (PYTHONUNBUFFERED), and
// no __pycache__ is written into the project, which the container
// would leave owned by root (PYTHONDONTWRITEBYTECODE). pip does not
// check for a newer version of itself. --extra_env can change any of
// these.
//
// @param image            The image to run; another release is passed as image = #python:<tag>.
// @param index_url        PIP_INDEX_URL; masked in the command log, since a private index URL often carries a credential.
// @param extra_index_url  PIP_EXTRA_INDEX_URL; masked in the command log.
// @param cache_dir        Host directory mounted at /cache, where pip keeps its cache (PIP_CACHE_DIR).
// @param with             Setups of other tools this environment should also carry.
// @param extra_env        Any other variable; below --with and the named parameters.
// @return The environment, for `command { "python" } on ...` or `$[...]`.
// @example lask eval python.env --cache_dir /tmp/pip-cache
env(
  --image: Environment = #python:3.12.14-alpine3.24,
  --index_url!!: String | Null = null,
  --extra_index_url!!: String | Null = null,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"PYTHONUNBUFFERED": "1", "PYTHONDONTWRITEBYTECODE": "1", "PIP_DISABLE_PIP_VERSION_CHECK": "1"},
    extra_env,
    with,
    vars({
      "PIP_INDEX_URL": index_url,
      "PIP_EXTRA_INDEX_URL": extra_index_url,
      "PIP_CACHE_DIR": in_cache(cache_dir, "pip")
    })
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

// Python works as it is, so its command words are exported, declared on
// the default environment, with the schemas a command string that runs
// them is checked against (lask spec ch. 5). A project imports the ones
// it runs: `import command { "python", "pip" } from "tools"`.
command { "python", "python3", "pip", "pip3" } on env() schema schema

// The command schema of python (lask spec ch. 5), from `python -h` in
// #python:3.12.14-alpine3.24, and the option letters it accepts though
// its help does not show them (-J, -R, -t). -c and -m end the options:
// what follows belongs to the program they run, as a script name does.
internal python_command: CommandSchema = {
  root: {
    closed: true,
    stop_at_first_positional: true,
    options: [
      { names: ["-b"], description: "issue warnings about str(bytes_instance) and comparing bytes with str" },
      { names: ["-B"], description: "don't write .pyc files on import" },
      { names: ["-c"], value: "required", stops: true, description: "program passed in as string" },
      { names: ["-d"], description: "turn on parser debugging output" },
      { names: ["-E"], description: "ignore PYTHON* environment variables" },
      { names: ["-h", "-?", "--help"], description: "print the help message and exit" },
      { names: ["-i"], description: "inspect interactively after running the script" },
      { names: ["-I"], description: "isolate Python from the user's environment" },
      { names: ["-J"] },
      { names: ["-m"], value: "required", stops: true, description: "run library module as a script" },
      { names: ["-O"], description: "remove assert and __debug__-dependent statements" },
      { names: ["-P"], description: "don't prepend a potentially unsafe path to sys.path" },
      { names: ["-q"], description: "don't print version and copyright messages on interactive startup" },
      { names: ["-R"] },
      { names: ["-s"], description: "don't add the user site directory to sys.path" },
      { names: ["-S"], description: "don't imply 'import site' on initialization" },
      { names: ["-t"] },
      { names: ["-u"], description: "force the stdout and stderr streams to be unbuffered" },
      { names: ["-v"], description: "verbose (trace import statements)" },
      { names: ["-V", "--version"], description: "print the Python version number and exit" },
      { names: ["-W"], value: "required", description: "warning control: action:message:category:module:lineno" },
      { names: ["-x"], description: "skip the first line of source" },
      { names: ["-X"], value: "required", description: "set an implementation-specific option" },
      { names: ["--check-hash-based-pycs"], value: "required", values: ["always", "default", "never"], description: "control how Python invalidates hash-based .pyc files" },
      { names: ["--help-env"], description: "print help about Python environment variables and exit" },
      { names: ["--help-xoptions"], description: "print help about implementation-specific -X options and exit" },
      { names: ["--help-all"], description: "print complete help information and exit" }
    ],
    description: "the Python interpreter"
  }
}

// The command schema of pip (lask spec ch. 5), read from `pip help` and
// `pip help <command>` in #python:3.12.14-alpine3.24 (pip 25.0.1). pip reads
// its options with optparse, which takes a long option shortened to a
// unique prefix.
