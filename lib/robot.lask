// The command schema of libdoc , read from its help and checked against
// the program: every option it lists is one the program accepts.
internal libdoc_command: CommandSchema = {
  root: {
    options: [
      { names: ["-f", "--format"], value: "required", description: "Specifies whether to generate an HTML output for humans, a machine readable spec file in XML or JSON format, or a Markdown file" },
      { names: ["-s", "--specdocformat"], value: "required", description: "Specifies the documentation format used with XML and JSON spec files" },
      { names: ["-F", "--docformat"], value: "required", description: "Specifies the source documentation format" },
      { names: ["--theme"], value: "required", description: "Use dark or light HTML theme" },
      { names: ["--language"], value: "required", description: "Set the default language used in HTML outputs" },
      { names: ["-n", "--name"], value: "required", description: "Sets the name of the documented library or resource" },
      { names: ["-v", "--version"], value: "required", description: "Sets the version of the documented library or resource" },
      { names: ["--quiet"], value: "optional", description: "Do not print the path of the generated output file to the console" },
      { names: ["-P", "--pythonpath"], value: "required", description: "Additional locations where to search for libraries and resources" },
      { names: ["-h", "-?", "--help"], value: "optional", description: "Print this help" }
    ]
  }
}

// The command schemas of robot, rebot, libdoc (lask spec ch. 5) for Robot Framework 7.5,
// the release in env()'s default image.
schema_7_5: Map<CommandSchema> = { "robot": robot_command, "rebot": rebot_command, "libdoc": libdoc_command }

// The command schemas of the release in env()'s default image: the
// ones a command string that runs these words is checked against.
schema: Map<CommandSchema> = schema_7_5
