// Robot Framework, with RequestsLibrary for API tests.

import { ToolSetup, layered_env, layered_volumes, vars } from "./common.lask"

// Robot Framework, with RequestsLibrary for API tests.
//
// There is no official image, so the image is built from
// lib/images/robot/Dockerfile: Robot Framework 7.5 and RequestsLibrary
// 0.9.7 on the Python image of python.env(). It takes no --image, and
// `lask sync` builds it. Another library is installed in the same command,
// `pip install -r requirements.txt && robot tests`; a browser library is
// better served by playwright.env().
//
// @param options    ROBOT_OPTIONS, which robot reads before its command line, e.g. "--outputdir results".
// @param network    The container's network: a Compose network, or "host".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "robot" } on ...` or `$[...]`.
// @example lask eval robot.env --options "--outputdir results"
env(
  --options: String | Null = null,
  --network: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = #./images/robot/Dockerfile{
  env: layered_env({"PYTHONUNBUFFERED": "1"}, extra_env, with, vars({"ROBOT_OPTIONS": options})),
  volumes: layered_volumes(with, []),
  network: network
}

command { "robot", "rebot", "libdoc" } on env() schema schema

// The command schema of robot 7.5, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal robot_command: CommandSchema = {
  root: {
    options: [
      { names: ["--rpa"], value: "optional", description: "Turn on the generic automation mode" },
      { names: ["--language"], value: "required", description: "Activate localization" },
      { names: ["-F", "--extension"], value: "required", description: "Parse only files with this extension when executing a directory" },
      { names: ["-I", "--parseinclude"], value: "required", description: "Parse only files matching `pattern`. It can be: - a file name or pattern like `example.robot` or `*.robot` to parse all files matching that " },
      { names: ["-N", "--name"], value: "required", description: "Set the name of the top level suite" },
      { names: ["-D", "--doc"], value: "required", description: "Set the documentation of the top level suite" },
      { names: ["-M", "--metadata"], value: "required", description: "Set metadata of the top level suite" },
      { names: ["-G", "--settag"], value: "required", description: "Sets given tag(s) to all executed tests" },
      { names: ["-t", "--test"], value: "required", description: "Select tests by name or by long name containing also parent suite name like `Parent.Test`. Name is case and space insensitive and it can als" },
      { names: ["--task"], value: "required", description: "Alias to --test" },
      { names: ["-s", "--suite"], value: "required", description: "Select suites by name" },
      { names: ["-i", "--include"], value: "required", description: "Select tests by tag" },
      { names: ["-e", "--exclude"], value: "required", description: "Select test cases not to run by tag" },
      { names: ["-R", "--rerunfailed"], value: "required", description: "Select failed tests from an earlier output file to be re-executed" },
      { names: ["-S", "--rerunfailedsuites"], value: "required", description: "Select failed suites from an earlier output file to be re-executed" },
      { names: ["--runemptysuite"], value: "optional", description: "Executes suite even if it contains no tests" },
      { names: ["--skip"], value: "required", description: "Tests having given tag will be skipped" },
      { names: ["--skiponfailure"], value: "required", description: "Tests having given tag will be skipped if they fail" },
      { names: ["-v", "--variable"], value: "required", description: "Set variables in the test data" },
      { names: ["-V", "--variablefile"], value: "required", description: "Python or YAML file file to read variables from" },
      { names: ["-d", "--outputdir"], value: "required", description: "Where to create output files" },
      { names: ["-o", "--output"], value: "required", description: "XML output file" },
      { names: ["--legacyoutput"], value: "optional", description: "Create XML output file in format compatible with Robot Framework 6.x and earlier" },
      { names: ["-l", "--log"], value: "required", description: "HTML log file" },
      { names: ["-r", "--report"], value: "required", description: "HTML report file" },
      { names: ["-x", "--xunit"], value: "required", description: "xUnit compatible result file" },
      { names: ["-b", "--debugfile"], value: "required", description: "Debug file written during execution" },
      { names: ["-T", "--timestampoutputs"], value: "optional", description: "When this option is used, timestamp in a format `YYYYMMDD-hhmmss` is added to all generated output files between their basename and extensio" },
      { names: ["--splitlog"], value: "optional", description: "Split the log file into smaller pieces that open in browsers transparently" },
      { names: ["--logtitle"], value: "required", description: "Title for the generated log file" },
      { names: ["--reporttitle"], value: "required", description: "Title for the generated report file" },
      { names: ["--reportbackground"], value: "required", description: "Background colors to use in the report file" },
      { names: ["--maxerrorlines"], value: "required", description: "Maximum number of error message lines to show in report when tests fail" },
      { names: ["--maxassignlength"], value: "required", description: "Maximum number of characters to show in log when variables are assigned" },
      { names: ["-L", "--loglevel"], value: "required", description: "Threshold level for logging" },
      { names: ["--suitestatlevel"], value: "required", description: "How many levels to show in `Statistics by Suite` in log and report" },
      { names: ["--tagstatinclude"], value: "required", description: "Include only matching tags in `Statistics by Tag` in log and report" },
      { names: ["--tagstatexclude"], value: "required", description: "Exclude matching tags from `Statistics by Tag`. This option can be used with --tagstatinclude similarly as --exclude is used with --include" },
      { names: ["--tagstatcombine"], value: "required", description: "Create combined statistics based on tags" },
      { names: ["--tagdoc"], value: "required", description: "Add documentation to tags matching the given pattern" },
      { names: ["--tagstatlink"], value: "required", description: "Add external links into `Statistics by Tag`. Pattern can use `*`, `?` and `[]` as wildcards like --test" },
      { names: ["--expandkeywords"], value: "required", description: "Matching keywords will be automatically expanded in the log file" },
      { names: ["--removekeywords"], value: "required", description: "Remove keyword data from the generated log file" },
      { names: ["--flattenkeywords"], value: "required", description: "Flattens matching keywords in the generated log file" },
      { names: ["--nostatusrc"], value: "optional", description: "Sets the return code to zero regardless of failures in test cases" },
      { names: ["--dryrun"], value: "optional", description: "Verifies test data and runs tests so that library keywords are not executed" },
      { names: ["-X", "--exitonfailure"], value: "optional", description: "Stops test execution if any test fails" },
      { names: ["--exitonerror"], value: "optional", description: "Stops test execution if any error occurs when parsing test data, importing libraries, and so on" },
      { names: ["--skipteardownonexit"], value: "optional", description: "Causes teardowns to be skipped if test execution is stopped prematurely" },
      { names: ["--randomize"], value: "required", description: "Randomizes the test execution order" },
      { names: ["--listener"], value: "required", description: "Class or module for monitoring test execution" },
      { names: ["--prerunmodifier"], value: "required", description: "Class to programmatically modify the suite structure before execution" },
      { names: ["--prerebotmodifier"], value: "required", description: "Class to programmatically modify the result model before creating reports and logs" },
      { names: ["--parser"], value: "required", description: "Custom parser class or module" },
      { names: ["--console"], value: "required", description: "How to report execution on the console" },
      { names: ["--quiet"], value: "optional", description: "Shortcut for `--console quiet`" },
      { names: ["-W", "--consolewidth"], value: "required", description: "Width of the console output" },
      { names: ["-C", "--consolecolors"], value: "required", description: "Use colors on console output or not" },
      { names: ["--consolelinks"], value: "required", description: "Control making paths to results files hyperlinks" },
      { names: ["-K", "--consolemarkers"], value: "required", description: "Show markers on the console when top level keywords in a test case end" },
      { names: ["-P", "--pythonpath"], value: "required", description: "Additional locations (directories, ZIPs) where to search libraries and other extensions when they are imported" },
      { names: ["-A", "--argumentfile"], value: "required", description: "Text file to read more arguments from" },
      { names: ["-h", "-?", "--help"], value: "optional", description: "Print usage instructions" },
      { names: ["--version"], value: "optional", description: "Print version information" }
    ]
  }
}

