// Git.

import { ToolSetup, git_trust, given, layered_env, layered_volumes, vars } from "./common.lask"
import * as ssh from "./ssh.lask"

// Git, configured by its parameters.
//
// The image is built from lib/images/unix/Dockerfile, as for unix.env(), so it
// takes no --image, and `lask sync` builds it. The container sees none of
// the host's Git configuration: the identity, a token for https and an SSH
// identity are given here, and the mounted project is trusted
// (safe.directory).
//
// @param name              GIT_AUTHOR_NAME and GIT_COMMITTER_NAME.
// @param email             GIT_AUTHOR_EMAIL and GIT_COMMITTER_EMAIL.
// @param token             An access token for https; masked in the command log. See git_setup.
// @param host              The host the token is for.
// @param token_user        The user name the host expects beside a token.
// @param ssh_dir           Host directory mounted read-only at /root/.ssh; see ssh_setup.
// @param ssh_agent_socket  Host path of an SSH agent socket (SSH_AUTH_SOCK); see ssh_setup.
// @param with              Setups of other tools this environment should also carry.
// @param extra_env         Any other variable; below --with and the named parameters.
// @return The environment, for `command { "git" } on ...` or `$[...]`.
// @example lask eval git.env --name "CI" --email ci@example.com
env(
  --name: String | Null = null,
  --email: String | Null = null,
  --token!!: String | Null = null,
  --host: String = "github.com",
  --token_user: String = "x-access-token",
  --ssh_dir: String | Null = null,
  --ssh_agent_socket: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = do {
  config = setup(token = token, host = host, token_user = token_user, name = name, email = email)
  identity = ssh.setup(dir = ssh_dir, agent_socket = ssh_agent_socket)
  #./images/unix/Dockerfile{
    env: layered_env({}, extra_env, with, merge(config.env, identity.env)),
    volumes: layered_volumes(with, identity.volumes)
  }
}

// Git's identity and its access to private repositories over https.
//
// The configuration is carried in GIT_CONFIG_* variables, so nothing
// is written to a file: the mounted project is trusted
// (safe.directory), and with a token, https://<host>/ and
// git@<host>: are both rewritten to https with the token in the URL.
// That reaches every tool that clones through Git — `go get` of a
// private module, a git dependency of npm, Cargo or Bundler. The token
// is masked wherever it appears.
//
// @param token       The access token; masked in the command log.
// @param host        The host the token is for.
// @param token_user  The user name the host expects beside a token: "x-access-token" for GitHub, "oauth2" for GitLab.
// @param name        GIT_AUTHOR_NAME and GIT_COMMITTER_NAME.
// @param email       GIT_AUTHOR_EMAIL and GIT_COMMITTER_EMAIL.
// @return The variables, for a tool's --with.
setup(
  --token!!: String | Null = null,
  --host: String = "github.com",
  --token_user: String = "x-access-token",
  --name: String | Null = null,
  --email: String | Null = null
): ToolSetup = do {
  config = case (token) {
    Null -> git_trust()
    else -> merge(git_trust(), {
      "GIT_CONFIG_COUNT": "3",
      "GIT_CONFIG_KEY_1": "url.https://#{token_user}:#{token}@#{host}/.insteadOf",
      "GIT_CONFIG_VALUE_1": "https://#{host}/",
      "GIT_CONFIG_KEY_2": "url.https://#{token_user}:#{token}@#{host}/.insteadOf",
      "GIT_CONFIG_VALUE_2": "git@#{host}:"
    })
  }
  identity = vars({
    "GIT_AUTHOR_NAME": name,
    "GIT_COMMITTER_NAME": name,
    "GIT_AUTHOR_EMAIL": email,
    "GIT_COMMITTER_EMAIL": email
  })
  {env: merge(config, identity), volumes: []}
}
