// golangci-lint, the Go linters runner.

import { ToolSetup, git_trust, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// golangci-lint, golangci/golangci-lint:v2.14.0 by default, with the Go
// it was built with. The mounted project is trusted by Git
// (safe.directory), since the linters that read history need it.
//
// @param image      The image to run; another release is passed as image = #golangci/golangci-lint:<tag>.
// @param cache_dir  Host directory mounted at /cache: golangci-lint's cache (/cache/golangci-lint), and Go's module and build caches (/cache/mod, /cache/build), shared with go.env().
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "golangci-lint" } on ...` or `$[...]`.
// @example lask eval golangci_lint.env --cache_dir /tmp/cache
env(
  --image: Environment = #golangci/golangci-lint:v2.14.0,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    git_trust(),
    extra_env,
    with,
    vars({
      "GOLANGCI_LINT_CACHE": in_cache(cache_dir, "golangci-lint"),
      "GOMODCACHE": in_cache(cache_dir, "mod"),
      "GOCACHE": in_cache(cache_dir, "build")
    })
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

command { "golangci-lint" } on env()
