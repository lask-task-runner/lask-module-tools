// Ruby, with RubyGems and Bundler.

import { vars, mount, in_cache, layered_env, layered_volumes, ToolSetup } from "./common.lask"

// Ruby, configured by its parameters.
//
// The image is #ruby:4.0.7-alpine3.24 unless --image names another. Alpine
// has no C toolchain, so a gem with a native extension and no prebuilt
// musl gem needs a Debian tag, e.g. 4.0.7-slim-trixie. `lask sync` pulls
// and pins whichever image is used (lask spec 10.3); a run never pulls.
//
// Bundler does not warn that it runs as root
// (BUNDLE_SILENCE_ROOT_WARNING=1): every container here does.
//
// @param image      The image to run; another release is passed as image = #ruby:<tag>.
// @param cache_dir  Host directory mounted at /cache; Bundler installs gems into /cache/bundle (BUNDLE_PATH), so they outlive the container.
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable, e.g. a BUNDLE_<HOST>__<DOMAIN> credential; below --with and the named parameters.
// @return The environment, for `command { "bundle" } on ...` or `$[...]`.
// @example lask eval ruby --cache_dir /tmp/cache
ruby(
  --image: Environment = #ruby:4.0.7-alpine3.24,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"BUNDLE_SILENCE_ROOT_WARNING": "1"},
    extra_env,
    with,
    vars({"BUNDLE_PATH": in_cache(cache_dir, "bundle")})
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

// Ruby works as it is, so its command words are exported.
command { "ruby", "gem", "bundle", "rake" } on ruby()
