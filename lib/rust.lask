    "install": { closed: true, options: [{ names: ["--profile"], value: "required", values: ["minimal", "default", "complete"] }, { names: ["-c", "--component"], value: "required", description: "Comma-separated list of components to be added on installation" }, { names: ["-t", "--target"], value: "required", description: "Comma-separated list of targets to be added on installation" }, { names: ["--no-self-update"], description: "Don't perform self update when running the `rustup toolchain install` command" }, { names: ["--no-update"], description: "Don't try to update the installed toolchain" }, { names: ["--force"], description: "Force an update, even if some components are missing" }, { names: ["--allow-downgrade"], description: "Allow rustup to downgrade the toolchain to satisfy your component choice" }, { names: ["--force-non-host"], description: "Install toolchains that require an emulator" }, { names: ["--override"], description: "Set the installed toolchain as the override for the current directory" }, { names: ["--default"], description: "Set the installed toolchain as the default toolchain" }, { names: ["-h", "--help"], description: "Print help" }], description: "Install or update the given toolchains, or by default the active toolchain" },
