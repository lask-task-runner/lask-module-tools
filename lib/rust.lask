// The command schema of rustc 1.98.1, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal rustc_command: CommandSchema = {
  root: {
    closed: true,
    options: [
      { names: ["-h", "--help"], description: "Display this message" },
      { names: ["--cfg"], value: "required", description: "Configure the compilation environment" },
      { names: ["--check-cfg"], value: "required", description: "Provide list of expected cfgs for checking" },
      { names: ["-L"], description: "Add a directory to the library search path" },
      { names: ["-l"], description: "Link the generated crate(s) to the specified native library NAME. The optional KIND can be one of <static|framework|dylib> (default: dylib)" },
      { names: ["--crate-type"], value: "required", description: "Comma separated list of types of crates for the compiler to emit" },
      { names: ["--crate-name"], value: "required", description: "Specify the name of the crate being built" },
      { names: ["--edition"], value: "optional", description: "Specify which edition of the compiler to use when compiling code" },
      { names: ["--emit"], value: "optional", description: "Comma separated list of types of output for the compiler to emit" },
      { names: ["--print"], value: "optional", description: "Compiler information to print on stdout (or to a file) INFO may be one of <all-target-specs-json|backend-has-mnemonic|backend-has-zstd|calli" },
      { names: ["-g"], description: "Equivalent to -C debuginfo=2" },
      { names: ["-O"], description: "Equivalent to -C opt-level=3" },
      { names: ["-o"], value: "required", description: "Write output to FILENAME" },
      { names: ["--out-dir"], value: "required" },
      { names: ["--explain"], value: "required" },
      { names: ["--test"], description: "Build a test harness" },
      { names: ["--target"], value: "required", description: "Target tuple for which the code is compiled" },
      { names: ["-A", "--allow"], value: "required", description: "Set lint allowed" },
      { names: ["-W", "--warn"], value: "required", description: "Set lint warnings" },
      { names: ["--force-warn"], value: "required", description: "Set lint force-warn" },
      { names: ["-D", "--deny"], value: "required", description: "Set lint denied" },
      { names: ["-F", "--forbid"], value: "required" },
      { names: ["--cap-lints"], value: "required", description: "Set the most restrictive lint level" },
      { names: ["-C", "--codegen"], value: "optional", description: "Set a codegen option" },
      { names: ["-V", "--version"], description: "Print version info and exit" },
      { names: ["-v", "--verbose"], description: "Use verbose output" },
      { names: ["-Z"], value: "optional" }
    ]
  }
}

