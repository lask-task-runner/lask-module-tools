      { names: ["--connect-es_opt"], value: "required", description: "the connect-es plugin's options" },
      { names: ["--doc_out"], value: "required", description: "the doc plugin's output directory" },
      { names: ["--doc_opt"], value: "required", description: "the doc plugin's options" },
      { names: ["--validate_out"], value: "required", description: "the validate plugin's output directory" },
      { names: ["--validate_opt"], value: "required", description: "the validate plugin's options" },
      { names: ["--java_grpc_out"], value: "required", description: "the java_grpc plugin's output directory" },
      { names: ["--java_grpc_opt"], value: "required", description: "the java_grpc plugin's options" },
      { names: ["--grpc_cpp_out"], value: "required", description: "the grpc_cpp plugin's output directory" },
      { names: ["--grpc_cpp_opt"], value: "required", description: "the grpc_cpp plugin's options" },
      { names: ["--swift_out"], value: "required", description: "the swift plugin's output directory" },
      { names: ["--swift_opt"], value: "required", description: "the swift plugin's options" },
      { names: ["--grpc-swift_out"], value: "required", description: "the grpc-swift plugin's output directory" },
