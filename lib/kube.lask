// What a Kubernetes client needs from an environment, for kubectl, helm and kustomize.

import { ToolSetup, given, mount, vars } from "./common.lask"

// What a Kubernetes client needs from an environment: a kubeconfig, and
// the context and namespace to use from it. Give it to another tool's
// --with — the Terraform kubernetes and helm providers, Pulumi — to
// reach the same cluster.
//
// The kubeconfig is mounted read-only, and the variables are set under
// each name the tools read: KUBECONFIG, KUBE_CONFIG_PATH (Terraform),
// HELM_KUBECONTEXT and KUBE_CTX, HELM_NAMESPACE. kubectl reads no
// variable for a context or a namespace: it uses the kubeconfig's
// current context unless `--context` and `-n` are given on its command
// line.
//
// @param kubeconfig  Host path of the kubeconfig, e.g. home(".kube/config").
// @param context     The context Helm and Terraform use.
// @param namespace   The namespace Helm uses.
// @return The variables and mounts, for a tool's --with.
setup(
  --kubeconfig: String | Null = null,
  --context: String | Null = null,
  --namespace: String | Null = null
): ToolSetup = {
  env: vars({
    "KUBECONFIG": given(kubeconfig, "/run/kube/config"),
    "KUBE_CONFIG_PATH": given(kubeconfig, "/run/kube/config"),
    "HELM_KUBECONTEXT": context,
    "KUBE_CTX": context,
    "HELM_NAMESPACE": namespace
  }),
  volumes: mount(kubeconfig, "/run/kube/config:ro")
}
