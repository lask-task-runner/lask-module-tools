// Secret managers: Vault, SOPS and the 1Password CLI. Each needs a
// credential, so none exports a command word.
//
// Each image is taken as --image, a head written here as its default or by
// the caller: `lask sync` pulls and pins whichever is used (lask spec
// 10.3), and a run never pulls. A value a command reads out of one of
// these is not masked by Lask: bind it to a `!!` parameter where it is
// used.

import { ToolSetup, vars, mount, given, layered_env, layered_volumes } from "./common.lask"

// What Vault clients read to reach a server: the vault CLI, the
// Terraform vault provider, most SDKs. Give it to another tool's --with.
//
// @param addr         VAULT_ADDR.
// @param token        VAULT_TOKEN; masked in the command log.
// @param namespace    VAULT_NAMESPACE, for Vault Enterprise or HCP.
// @param skip_verify  VAULT_SKIP_VERIFY: "true" to accept a certificate the container cannot verify.
// @return The variables, for a tool's --with.
vault_setup(
  --addr: String | Null = null,
  --token!!: String | Null = null,
  --namespace: String | Null = null,
  --skip_verify: String | Null = null
): ToolSetup = {
  env: vars({
    "VAULT_ADDR": addr,
    "VAULT_TOKEN": token,
    "VAULT_NAMESPACE": namespace,
    "VAULT_SKIP_VERIFY": skip_verify
  }),
  volumes: []
}

// The Vault CLI, hashicorp/vault:1.21.4 by default.
//
// @param image        The image to run; another release is passed as image = #hashicorp/vault:<tag>.
// @param addr         VAULT_ADDR.
// @param token        VAULT_TOKEN; masked in the command log.
// @param namespace    VAULT_NAMESPACE.
// @param skip_verify  VAULT_SKIP_VERIFY.
// @param with         Setups of other tools this environment should also carry.
// @param extra_env    Any other variable; below --with and the named parameters.
// @return The environment, for `command { "vault" } on ...` or `$[...]`.
// @example lask eval vault --addr https://vault.example.com:8200
vault(
  --image: Environment = #hashicorp/vault:1.21.4,
  --addr: String | Null = null,
  --token!!: String | Null = null,
  --namespace: String | Null = null,
  --skip_verify: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = do {
  own = vault_setup(addr = addr, token = token, namespace = namespace, skip_verify = skip_verify)
  return runnable(image,
    env = layered_env({}, extra_env, with, own.env),
    volumes = layered_volumes(with, [])
  )
}

// SOPS, ghcr.io/getsops/sops:v3.13.3-alpine by default.
//
// An age key is given here; a cloud KMS key takes that cloud's setup
// through --with: aws_setup, gcloud_setup, azure_setup, vault_setup.
//
// @param image         The image to run; another release is passed as image = #ghcr.io/getsops/sops:<tag>.
// @param age_key       SOPS_AGE_KEY, the private key itself; masked in the command log.
// @param age_key_file  Host path of an age key file, mounted read-only at /run/secrets/age-key.txt (SOPS_AGE_KEY_FILE).
// @param with          Setups of other tools this environment should also carry: a KMS's credentials.
// @param extra_env     Any other variable; below --with and the named parameters.
// @return The environment, for `command { "sops" } on ...` or `$[...]`.
// @example lask eval sops --age_key_file /home/me/.config/sops/age/keys.txt
sops(
  --image: Environment = #ghcr.io/getsops/sops:v3.13.3-alpine,
  --age_key!!: String | Null = null,
  --age_key_file: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {},
    extra_env,
    with,
    vars({"SOPS_AGE_KEY": age_key, "SOPS_AGE_KEY_FILE": given(age_key_file, "/run/secrets/age-key.txt")})
  ),
  volumes = layered_volumes(with, mount(age_key_file, "/run/secrets/age-key.txt:ro"))
)

// The 1Password CLI, 1password/op:2.39.0 by default.
//
// A container cannot reach the desktop app's integration: authenticate
// with a service account token, or with a Connect server.
//
// @param image                  The image to run; another release is passed as image = #1password/op:<tag>.
// @param service_account_token  OP_SERVICE_ACCOUNT_TOKEN; masked in the command log.
// @param connect_host           OP_CONNECT_HOST.
// @param connect_token          OP_CONNECT_TOKEN; masked in the command log.
// @param with                   Setups of other tools this environment should also carry.
// @param extra_env              Any other variable; below --with and the named parameters.
// @return The environment, for `command { "op" } on ...` or `$[...]`.
// @example lask eval op
op(
  --image: Environment = #1password/op:2.39.0,
  --service_account_token!!: String | Null = null,
  --connect_host: String | Null = null,
  --connect_token!!: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {},
    extra_env,
    with,
    vars({
      "OP_SERVICE_ACCOUNT_TOKEN": service_account_token,
      "OP_CONNECT_HOST": connect_host,
      "OP_CONNECT_TOKEN": connect_token
    })
  ),
  volumes = layered_volumes(with, [])
)
