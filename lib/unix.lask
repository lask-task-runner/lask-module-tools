    "cmp": { closed: true, options: [{ names: ["-help"], description: "Display this summary" }, { names: ["-config"], value: "required", description: "Configuration file to use" }, { names: ["-section"], value: "required", description: "Section(s) in config file to get options from" }, { names: ["-verbosity"], value: "required", description: "Log level; 3=ERR, 4=WARN, 6=INFO, 7=DEBUG, 8=TRACE. Default 6 = INFO" }, { names: ["-cmd"], value: "required", description: "CMP request to send: ir/cr/kur/p10cr/rr/genm" }, { names: ["-infotype"], value: "required", description: "InfoType name for requesting specific info in genm, with specific support for 'caCerts' and 'rootCaCert'" }, { names: ["-profile"], value: "required", description: "Certificate profile name to place in generalInfo field of request PKIHeader" }, { names: ["-geninfo"], value: "required", description: "Comma-separated list of OID and value to place in generalInfo PKIHeader of form <OID>:int:<n> or <OID>:str:<s>, e.g" }, { names: ["-template"], value: "required", description: "File to save certTemplate received in genp of type certReqTemplate" }, { names: ["-keyspec"], value: "required", description: "Optional file to save Key specification received in genp of type certReqTemplate" }, { names: ["-newkey"], value: "required", description: "Private or public key for the requested cert" }, { names: ["-newkeypass"], value: "required", description: "New private key pass phrase source" }, { names: ["-centralkeygen"], description: "Request central (server-side) key generation" }, { names: ["-newkeyout"], value: "required", description: "File to save centrally generated key, in PEM format" }, { names: ["-subject"], value: "required", description: "Distinguished Name (DN) of subject to use in the requested cert template For kur, default is subject of -csr arg or reference cert (see -old" }, { names: ["-days"], value: "required", description: "Requested validity time of the new certificate in number of days" }, { n