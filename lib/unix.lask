      { names: ["-u"], description: "update files, create if necessary -z display archive comment only" },
      { names: ["-v"], description: "list verbosely/show version info -T timestamp archive to latest" },
      { names: ["-x"], description: "exclude files that follow (in xlist) -d extract files into exdir" },
      { names: ["-n"], description: "never overwrite existing files -q quiet mode (-qq => quieter)" },
      { names: ["-o"], description: "overwrite files WITHOUT prompting -a auto-convert any text files" },
      { names: ["-j"], description: "junk paths (do not make directories) -aa treat ALL files as text" },
      { names: ["-U"], description: "use escapes for all non-ASCII Unicode -UU ignore any Unicode fields" },
      { names: ["-C"], description: "match filenames case-insensitively -L make (some) names lowercase" },
      { names: ["-X"], description: "restore UID/GID info -V retain VMS version numbers" },
      { names: ["-K"], description: "keep setuid/setgid/tacky permissions -M pipe through \"more\" pager" },
      { names: ["--debug"], value: "optional" },
      { names: ["--help"], value: "optional" },
      { names: ["--quiet"], value: "optional" },
      { names: ["--verbose"], value: "optional" },
      { names: ["--version"], value: "optional" },
      { names: ["-V"], value: "optional" },
      { names: ["-d"], value: "optional" },
      { names: ["-h"], value: "optional" },
      { names: ["-q"], value: "optional" }
    ]
  }
}

