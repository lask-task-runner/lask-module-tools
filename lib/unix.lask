// The everyday command-line tools: curl and wget, jq and yq, and the
// GNU tools around them.

import { ToolSetup, layered_env, layered_volumes } from "./common.lask"

// A shell with the everyday command-line tools, in one image.
//
// A command string runs in one environment, so `curl -s ... | jq -r .id`
// needs curl and jq in the same image; this is that image. It holds
// bash, curl, wget, openssl, jq, yq, envsubst, GNU coreutils, findutils,
// grep, sed and awk, diff, file, tar, gzip, xz, bzip2, zip and unzip,
// rsync, make, and the SSH client; and git, gh and glab, which git.env(),
// gh.env() and glab.env() configure.
//
// The image is built from lib/images/unix/Dockerfile, Alpine 3.24 pinned
// by its digest, so it takes no --image: the recipe is what fixes it, and
// `lask sync` builds it once per machine (lask spec 10.3). A run never
// builds.
//
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable, e.g. HTTPS_PROXY; below --with.
// @return The environment, for `command { "curl" } on ...` or `$[...]`.
// @example lask eval unix.env
env(
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = #./images/unix/Dockerfile{
  env: layered_env({}, extra_env, with, {}),
  volumes: layered_volumes(with, [])
}

// The tools need nothing from the caller, so their command words are
// exported, declared on the default environment. A project imports the
// ones it runs: `import command { "curl", "jq" } from "tools"`. The
// shell's own words — grep, sed, awk and the rest — are in every image,
// and are not exported: importing them would pull a command string that
// also runs npm or python into this environment, and conflict. Nor are
// git, gh, glab and ssh, which need an identity: git.env() and the others
// configure them. make is cc's.
command {
  "curl", "wget", "openssl",
  "jq", "yq", "envsubst",
  "tar", "gzip", "xz", "bzip2", "zip", "unzip",
  "rsync"
} on env() schema schema

// The command schema of curl 8.22.0, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal curl_command: CommandSchema = {
  root: {
    closed: true,
    intermixed: true,
    options: [
      { names: ["--abstract-unix-socket"], value: "required", description: "Connect via abstract Unix domain socket" },
      { names: ["--alt-svc"], value: "required", description: "Enable alt-svc with this cache file" },
      { names: ["--anyauth"], value: "optional", description: "Pick any authentication method" },
