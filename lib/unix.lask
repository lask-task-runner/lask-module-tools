ipient nor -srvcert are given" }, { names: ["-serial"], value: "required", description: "Serial number of certificate to be revoked in revocation request (rr)" }, { names: ["-revreason"], value: "required", description: "Reason code to include in revocation request (rr); possible values: 0..6, 8..10 (see RFC5280, 5.3.1) or -1" }, { names: ["-server"], value: "required", description: "[http[s]://]address[:port][/path] of CMP server" }, { names: ["-proxy"], value: "required", description: "[http[s]://]address[:port][/path] of HTTP(S) proxy to use; path is ignored" }, { names: ["-no_proxy"], value: "required", description: "List of addresses of servers not to use HTTP(S) proxy for Default from environment variable 'no_proxy', else 'NO_PROXY', else none" }, { names: ["-recipient"], value: "required", description: "DN of CA. Default: subject of -srvcert, -issuer, issuer of -oldcert or -cert" }, { names: ["-path"], value: "required", description: "HTTP path (aka CMP alias) at the CMP server" }, { names: ["-keep_alive"], value: "required", description: "Persistent HTTP connections" }, { names: ["-msg_timeout"], value: "required", description: "Number of seconds allowed per CMP message round trip, or 0 for infinite" }, { names: ["-total_timeout"], value: "required", description: "Overall time an enrollment incl" }, { names: ["-trusted"], value: "required", description: "Certificates to use as trust anchors when verifying signed CMP responses unless -srvcert is given" }, { names: ["-untrusted"], value: "required", description: "Intermediate CA certs for chain construction for CMP/TLS/enrolled certs" }, { names: ["-srvcert"], value: "required", description: "Server cert to pin and trust directly when verifying signed CMP responses" }, { names: ["-expect_sender"], value: "required", description: "DN of expected sender of responses" }, { names: ["-ignore_keyusage"], description: "Ignore CMP signer cert key usage, else 'digitalSignature' must be allowed" }, { names: ["-unprotect