ial; do not store it" }, { names: ["-multivalue-rdn"], description: "Deprecated; multi-valued RDNs support is always on" }, { names: ["-startdate"], value: "required", description: "[CC]YYMMDDHHMMSSZ value for notBefore certificate field" }, { names: ["-not_before"], value: "required", description: "An alias for -startdate" }, { names: ["-enddate"], value: "required", description: "[CC]YYMMDDHHMMSSZ value for notAfter certificate field, overrides -days" }, { names: ["-not_after"], value: "required", description: "An alias for -enddate" }, { names: ["-days"], value: "required", description: "Number of days from today to certify the cert for" }, { names: ["-extensions"], value: "required", description: "Extension section (override value in config file)" }, { names: ["-extfile"], value: "required", description: "Configuration file with X509v3 extensions to add" }, { names: ["-preserveDN"], description: "Don't re-order the DN" }, { names: ["-noemailDN"], description: "Don't add the EMAIL field to the DN" }, { names: ["-md"], value: "required", description: "Digest to use, such as sha256" }, { names: ["-keyfile"], value: "required", description: "The CA private key" }, { names: ["-keyform"], value: "required", description: "Private key file format (ENGINE, other values ignored)" }, { names: ["-passin"], value: "required", description: "Key and cert input file pass phrase source" }, { names: ["-key"], value: "required", description: "Key to decrypt the private key or cert files if encrypted" }, { names: ["-cert"], value: "required", description: "The CA cert" }, { names: ["-certform"], value: "required", description: "Certificate input format (DER/PEM/P12); has no effect" }, { names: ["-selfsign"], description: "Sign a cert with the key associated with it" }, { names: ["-sigopt"], value: "required", description: "Signature parameter in n:v form" }, { names: ["-vfyopt"], value: "required", description: "Verification parameter in n:v form" }, { names: ["-gencrl"], descripti