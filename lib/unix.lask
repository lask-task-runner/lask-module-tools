olicy set" }, { names: ["-purpose"], value: "required", description: "certificate chain purpose" }, { names: ["-verify_name"], value: "required", description: "verification policy name" }, { names: ["-verify_depth"], value: "required", description: "chain depth limit" }, { names: ["-auth_level"], value: "required", description: "chain authentication security level" }, { names: ["-attime"], value: "required", description: "verification epoch time" }, { names: ["-verify_hostname"], value: "required", description: "expected peer hostname" }, { names: ["-verify_email"], value: "required", description: "expected peer email" }, { names: ["-verify_ip"], value: "required", description: "expected peer IP address" }, { names: ["-ignore_critical"], description: "permit unhandled critical extensions" }, { names: ["-issuer_checks"], description: "(deprecated)" }, { names: ["-crl_check"], description: "check leaf certificate revocation" }, { names: ["-crl_check_all"], description: "check full chain revocation" }, { names: ["-policy_check"], description: "perform rfc5280 policy checks" }, { names: ["-explicit_policy"], description: "set policy variable require-explicit-policy" }, { names: ["-inhibit_any"], description: "set policy variable inhibit-any-policy" }, { names: ["-inhibit_map"], description: "set policy variable inhibit-policy-mapping" }, { names: ["-x509_strict"], description: "disable certificate compatibility work-arounds" }, { names: ["-extended_crl"], description: "enable extended CRL features" }, { names: ["-use_deltas"], description: "use delta CRLs" }, { names: ["-policy_print"], description: "print policy processing diagnostics" }, { names: ["-check_ss_sig"], description: "check root CA self-signatures" }, { names: ["-trusted_first"], description: "search trust store first (default)" }, { names: ["-suiteB_128_only"], description: "Suite B 128-bit-only mode" }, { names: ["-suiteB_128"], description: "Suite B 128-bit mode allowing 192-bit algorithms" }, { names: [