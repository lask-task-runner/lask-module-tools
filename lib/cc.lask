// C and C++, with GCC and Make.

import { ToolSetup, layered_env, layered_volumes, vars } from "./common.lask"

// GCC, with Make, configured by its parameters.
//
// The image is #gcc:16.2.0 unless --image names another. It has no CMake.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// @param image      The image to run; another release is passed as image = #gcc:<tag>.
// @param cc         CC.
// @param cxx        CXX.
// @param cflags     CFLAGS.
// @param cxxflags   CXXFLAGS.
// @param ldflags    LDFLAGS.
// @param makeflags  MAKEFLAGS, e.g. "-j8".
// @param with       Setups of other tools this environment should also carry.
// @param extra_env  Any other variable; below --with and the named parameters.
// @return The environment, for `command { "make" } on ...` or `$[...]`.
// @example lask eval cc.env --cflags "-O2 -Wall"
env(
  --image: Environment = #gcc:16.2.0,
  --cc: String | Null = null,
  --cxx: String | Null = null,
  --cflags: String | Null = null,
  --cxxflags: String | Null = null,
  --ldflags: String | Null = null,
  --makeflags: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {},
    extra_env,
    with,
    vars({
      "CC": cc,
      "CXX": cxx,
      "CFLAGS": cflags,
      "CXXFLAGS": cxxflags,
      "LDFLAGS": ldflags,
      "MAKEFLAGS": makeflags
    })
  ),
  volumes = layered_volumes(with, [])
)

// The compilers and Make work as they are, so their command words are
// exported, make with the schema a command string that runs it is checked
// against (lask spec ch. 5).
command { "gcc", "g++", "cc", "c++", "make" } on env() schema schema

// The command schema of GNU make 4.4.1 (lask spec ch. 5), from
// `make --help` in #gcc:16.2.0, with the options it keeps for itself
// (--jobserver-auth, --jobserver-fds, --temp-stdin). It reads long
// options with getopt_long, which takes a unique prefix of one. Targets
// and VAR=value assignments may come among the options.
internal make_command: CommandSchema = {
  root: {
    closed: true,
    abbreviations: true,
    options: [
      { names: ["-b", "-m"], description: "ignored for compatibility" },
      { names: ["-B", "--always-make"], description: "unconditionally make all targets" },
      { names: ["-C", "--directory"], value: "required", description: "change to this directory before doing anything" },
      { names: ["-d"], description: "print lots of debugging information" },
      { names: ["--debug"], value: "optional", description: "print various types of debugging information" },
      { names: ["-e", "--environment-overrides"], description: "environment variables override makefiles" },
      { names: ["-E", "--eval"], value: "required", description: "evaluate this string as a makefile statement" },
      { names: ["-f", "--file", "--makefile"], value: "required", description: "read this file as a makefile" },
      { names: ["-h", "--help"], description: "print the help message and exit" },
      { names: ["-i", "--ignore-errors"], description: "ignore errors from recipes" },
      { names: ["-I", "--include-dir"], value: "required", description: "search this directory for included makefiles" },
      { names: ["-j", "--jobs"], value: "optional", description: "allow this many jobs at once; infinite jobs with no number" },
      { names: ["--jobserver-style"], value: "required", description: "the style of jobserver to use" },
      { names: ["-k", "--keep-going"], description: "keep going when some targets can't be made" },
      { names: ["-l", "--load-average", "--max-load"], value: "optional", description: "don't start multiple jobs unless the load is below this" },
      { names: ["-L", "--check-symlink-times"], description: "use the latest mtime between symlinks and target" },
      { names: ["-n", "--just-print", "--dry-run", "--recon"], description: "don't run any recipe; just print them" },
      { names: ["-o", "--old-file", "--assume-old"], value: "required", description: "consider this file very old and don't remake it" },
      { names: ["-O", "--output-sync"], value: "optional", description: "synchronize the output of parallel jobs by this type" },
      { names: ["-p", "--print-data-base"], description: "print make's internal database" },
      { names: ["-q", "--question"], description: "run no recipe; the exit status says if up to date" },
      { names: ["-r", "--no-builtin-rules"], description: "disable the built-in implicit rules" },
      { names: ["-R", "--no-builtin-variables"], description: "disable the built-in variable settings" },
      { names: ["--shuffle"], value: "optional", description: "shuffle prerequisites and goals: a seed, random, reverse or none" },
      { names: ["-s", "--silent", "--quiet"], description: "don't echo recipes" },
      { names: ["--no-silent"], description: "echo recipes" },
      { names: ["-S", "--no-keep-going", "--stop"], description: "turn off -k" },
      { names: ["-t", "--touch"], description: "touch targets instead of remaking them" },
      { names: ["--trace"], description: "print tracing information" },
      { names: ["-v", "--version"], description: "print the version number of make and exit" },
      { names: ["-w", "--print-directory"], description: "print the current directory" },
      { names: ["--no-print-directory"], description: "turn off -w" },
      { names: ["-W", "--what-if", "--new-file", "--assume-new"], value: "required", description: "consider this file infinitely new" },
      { names: ["--warn-undefined-variables"], description: "warn when an undefined variable is referenced" },
      { names: ["--jobserver-auth"], value: "required" },
      { names: ["--jobserver-fds"], value: "required" },
      { names: ["--temp-stdin"], value: "required" }
    ],
    description: "GNU make"
  }
}

// The command schema of gcc 16.2.0, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal gcc_command: CommandSchema = {
  root: {
    style: "single-dash",
    intermixed: true,
    options: [
      { names: ["--help"], description: "Display this information" },
      { names: ["--target-help"], description: "Display target specific command line options (including assembler and linker options)" },
      { names: ["--version"], value: "optional", description: "Display compiler version information" },
      { names: ["-dumpspecs"], value: "optional", description: "Display all of the built in spec strings" },
      { names: ["-dumpversion"], value: "optional", description: "Display the version of the compiler" },
      { names: ["-dumpmachine"], value: "optional", description: "Display the compiler's target processor" },
      { names: ["-print-search-dirs"], description: "Display the directories in the compiler's search path" },
      { names: ["-print-libgcc-file-name"], description: "Display the name of the compiler's companion library" },
      { names: ["-print-multiarch"], description: "Display the target's normalized GNU triplet, used as a component in the library path" },
      { names: ["-print-multi-directory"], description: "Display the root directory for versions of libgcc" },
      { names: ["-print-multi-lib"], description: "Display the mapping between command line options and multiple library search directories" },
      { names: ["-print-multi-os-directory"], value: "required" },
      { names: ["-print-sysroot"], description: "Display the target libraries directory" },
      { names: ["-print-sysroot-headers-suffix"], value: "required" },
      { names: ["-Xassembler"], value: "required", description: "Pass <arg> on to the assembler" },
      { names: ["-Xpreprocessor"], value: "required", description: "Pass <arg> on to the preprocessor" },
      { names: ["-Xlinker"], value: "required", description: "Pass <arg> on to the linker" },
      { names: ["-specs"], value: "required", description: "Override built-in specs with the contents of <file>" },
      { names: ["--sysroot"], value: "required", description: "Use <directory> as the root directory for headers and libraries" },
      { names: ["-B"], value: "required", description: "Add <directory> to the compiler's search paths" },
      { names: ["-v"], description: "Display the programs invoked by the compiler" },
      { names: ["-E"], description: "Preprocess only; do not compile, assemble or link" },
      { names: ["-S"], description: "Compile only; do not assemble or link" },
      { names: ["-c"], description: "Compile and assemble, but do not link" },
      { names: ["-o"], value: "required", description: "Place the output into <file>" },
      { names: ["-x"], value: "required", description: "Specify the language of the following input files" },
      { names: ["--debug"], value: "optional" },
      { names: ["--verbose"], value: "optional" },
      { names: ["-A"], value: "optional" },
      { names: ["-C"], value: "optional" },
      { names: ["-D"], value: "required", prefix: true },
      { names: ["-F"], value: "optional" },
      { names: ["-H"], value: "optional" },
      { names: ["-I"], value: "required", prefix: true },
      { names: ["-J"], value: "optional" },
      { names: ["-L"], value: "required", prefix: true },
      { names: ["-M"], value: "optional" },
      { names: ["-N"], value: "optional" },
      { names: ["-O"], value: "optional", prefix: true },
      { names: ["-P"], value: "optional" },
      { names: ["-Q"], value: "optional" },
      { names: ["-R"], value: "optional" },
      { names: ["-T"], value: "optional" },
      { names: ["-U"], value: "required", prefix: true },
      { names: ["-W"], value: "required", prefix: true },
      { names: ["-Z"], value: "optional" },
      { names: ["-d"], value: "optional" },
      { names: ["-e"], value: "optional" },
      { names: ["-g"], value: "optional", prefix: true },
      { names: ["-h"], value: "optional" },
      { names: ["-l"], value: "required", prefix: true },
      { names: ["-n"], value: "optional" },
      { names: ["-p"], value: "optional" },
      { names: ["-r"], value: "optional" },
      { names: ["-s"], value: "optional" },
      { names: ["-t"], value: "optional" },
      { names: ["-u"], value: "optional" },
      { names: ["-w"], value: "optional" },
      { names: ["-z"], value: "optional" },
      { names: ["-f"], value: "required", prefix: true, description: "code generation and language options" },
      { names: ["-m"], value: "required", prefix: true, description: "machine options" },
      { names: ["-pipe"] },
      { names: ["-shared"] },
      { names: ["-static"] },
      { names: ["-static-libgcc"] },
      { names: ["-static-libstdc++"] },
