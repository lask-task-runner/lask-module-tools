// The command schemas of make, gcc, g++, cc, c++ (lask spec ch. 5) for GCC 16.2.0 and its GNU make 4.4.1,
// the release in env()'s default image.
schema_16_2_0: Map<CommandSchema> = { "make": make_command, "gcc": gcc_command, "g++": gcc_command, "cc": gcc_command, "c++": gcc_command }

// The command schemas of the release in env()'s default image: the
// ones a command string that runs these words is checked against.
schema: Map<CommandSchema> = schema_16_2_0
