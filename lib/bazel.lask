// Bazel, through Bazelisk.

import { ToolSetup, git_trust, given, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// Bazel, through Bazelisk.
//
// The image is built from lib/images/bazel/Dockerfile: Bazelisk 1.29.0 on
// Debian, with a C++ compiler, Python and Git. Bazel's own image is
// published for amd64 only. Bazelisk runs the Bazel release the project's
// .bazelversion names, downloading it on first use; without --cache_dir
// that is every run. The image takes no --image, and `lask sync` builds
// it.
//
// @param cache_dir    Host directory mounted at /cache: Bazelisk's downloads (BAZELISK_HOME=/cache/bazelisk) and Bazel's output root (XDG_CACHE_HOME=/cache), so a build is incremental across runs.
// @param base_access  What the container may do with the project directory: "rw" (the default), "ro", "none", or a table of paths such as {".": "ro", "dist": "rw"} (lask spec 10.2).
// @param with         Setups of other tools this environment should also carry.
// @param extra_env    Any other variable; below --with and the named parameters.
// @return The environment, for `command { "bazel" } on ...` or `$[...]`.
// @example lask eval bazel.env --cache_dir /tmp/cache
env(
  --cache_dir: String | Null = null,
  --base_access: String | Map<String> | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = #./images/bazel/Dockerfile{
  env: layered_env(
    git_trust(),
    extra_env,
    with,
    vars({"BAZELISK_HOME": in_cache(cache_dir, "bazelisk"), "XDG_CACHE_HOME": given(cache_dir, "/cache")})
  ),
  volumes: layered_volumes(with, mount(cache_dir, "/cache")),
  base_access: base_access
}

command { "bazel", "bazelisk" } on env()
