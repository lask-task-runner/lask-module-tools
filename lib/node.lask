// Node.js, with npm and npx.

import { ToolSetup, in_cache, layered_env, layered_volumes, mount, vars } from "./common.lask"

// Node.js, configured by its parameters.
//
// The image is #node:24.22.1-alpine3.24 (an LTS release) unless --image
// names another. `lask sync` pulls and pins whichever image is used (lask
// spec 10.3); a run never pulls.
//
// npm does not check for a newer version of itself, which would
// otherwise print a notice into the command log. --extra_env can change
// that.
//
// @param image         The image to run; another release is passed as image = #node:<tag>.
// @param node_env      NODE_ENV.
// @param node_options  NODE_OPTIONS.
// @param registry      npm_config_registry: the registry npm installs from.
// @param npm_token     NPM_TOKEN, for an .npmrc that reads ${NPM_TOKEN}; masked in the command log.
// @param cache_dir     Host directory mounted at /cache, where npm keeps its cache (npm_config_cache).
// @param with          Setups of other tools this environment should also carry.
// @param extra_env     Any other variable; below --with and the named parameters.
// @return The environment, for `command { "npm" } on ...` or `$[...]`.
// @example lask eval node.env --node_env production
env(
  --image: Environment = #node:24.22.1-alpine3.24,
  --node_env: String | Null = null,
  --node_options: String | Null = null,
  --registry: String | Null = null,
  --npm_token!!: String | Null = null,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    {"npm_config_update_notifier": "false"},
    extra_env,
    with,
    vars({
      "NODE_ENV": node_env,
      "NODE_OPTIONS": node_options,
      "npm_config_registry": registry,
      "NPM_TOKEN": npm_token,
      "npm_config_cache": in_cache(cache_dir, "npm")
    })
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

// Node.js works as it is, so its command words are exported, declared
// on the default environment. A project imports the ones it runs:
// `import command { "node", "npm", "npx" } from "tools"`.
command { "node", "npm", "npx", "corepack" } on env() schema schema

// The command schema of node 24.22.1, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal node_command: CommandSchema = {
  root: {
    stop_at_first_positional: true,
    options: [
      { names: ["--abort-on-uncaught-exception"], description: "aborting instead of exiting causes a core file to be generated for analysis" },
      { names: ["--allow-addons"], value: "optional", description: "allow use of addons when any permissions are set" },
      { names: ["--allow-child-process"], value: "optional", description: "allow use of child process when any permissions are set" },
      { names: ["--allow-fs-read"], value: "required", description: "allow permissions to read the filesystem" },
      { names: ["--allow-fs-write"], value: "required", description: "allow permissions to write in the filesystem" },
      { names: ["--allow-inspector"], value: "optional", description: "allow use of inspector when any permissions are set" },
      { names: ["--allow-openssl-store"], value: "optional", description: "allow use of OpenSSL STORE loaders when any permissions are set" },
      { names: ["--allow-wasi"], value: "optional", description: "allow wasi when any permissions are set" },
      { names: ["--allow-worker"], value: "optional", description: "allow worker threads when any permissions are set" },
      { names: ["--build-snapshot"], value: "optional", description: "Generate a snapshot blob when the process exits" },
      { names: ["--build-snapshot-config"], value: "required", description: "process exits using aJSON configuration in the specified path" },
      { names: ["-c", "--check"], value: "optional", description: "syntax check script without executing" },
      { names: ["--completion-bash"], value: "optional", description: "print source-able bash completion script" },
      { names: ["-C", "--conditions"], value: "required", description: "additional user conditions for conditional exports and imports" },
      { names: ["--cpu-prof"], value: "optional", description: "Start the V8 CPU profiler on start up, and write the CPU profile to disk before exit" },
      { names: ["--cpu-prof-dir"], value: "required", description: "Directory where the V8 profiles generated by --cpu-prof will be placed" },
      { names: ["--cpu-prof-interval"], value: "required", description: "specified sampling interval in microseconds for the V8 CPU profile generated with --cpu-prof" },
      { names: ["--cpu-prof-name"], value: "required", description: "specified file name of the V8 CPU profile generated with --cpu-prof" },
      { names: ["--diagnostic-dir"], value: "required", description: "set dir for all output files (default: current working directory)" },
      { names: ["--disable-proto"], value: "required", description: "disable Object.prototype.__proto__" },
      { names: ["--disable-sigusr1"], value: "optional", description: "Disable inspector thread to be listening for SIGUSR1 signal" },
