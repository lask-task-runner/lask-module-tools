      { names: ["-m"], value: "optional" },
      { names: ["-A"], value: "required", prefix: true, description: "options to pass to annotation processors" },
      { names: ["-g:"], value: "required", prefix: true, description: "generate only some debugging info" },
      { names: ["-implicit:"], value: "required", prefix: true, description: "whether to generate class files for implicitly referenced files" },
      { names: ["-proc:"], value: "required", prefix: true, description: "control annotation processing" }
    ]
  }
}

// The command schema of jar 25.0.4, read from its help and checked against
// the program: every option it lists is one the program accepts.
internal jar_command: CommandSchema = {
  root: {
    options: [
      { names: ["-C"], value: "required" },
      { names: ["-c", "--create"], description: "Create the archive" },
      { names: ["-i", "--generate-index"], value: "required", description: "Generate index information for the specified jar archives" },
      { names: ["-t", "--list"], description: "List the table of contents for the archive" },
      { names: ["-u", "--update"], description: "Update an existing jar archive" },
      { names: ["-x", "--extract"], description: "Extract named (or all) files from the archive" },
      { names: ["-d", "--describe-module"], description: "Print the module descriptor, or automatic module name" },
      { names: ["--validate"], description: "Validate the contents of the jar archive" },
      { names: ["-f", "--file"], value: "required", description: "The archive file name" },
      { names: ["--release"], value: "required", description: "Places all following files in a versioned directory of the jar (i.e" },
      { names: ["-v", "--verbose"], description: "Generate verbose output on standard output" },
      { names: ["-e", "--main-class"], value: "required", description: "applications bundled into a modular, or executable, jar archive" },
      { names: ["-m", "--manifest"], value: "required", description: "Include the manifest information from the given manifest file" },
      { names: ["-M", "--no-manifest"], description: "Do not create a manifest file for the entries" },
      { names: ["--module-version"], value: "required", description: "The module version, when creating a modular jar, or updating a non-modular jar" },
      { names: ["--hash-modules"], value: "required", description: "matched by the given pattern and that depend upon directly or indirectly on a modular jar being created or a non-modular jar being updated" },
      { names: ["-p", "--module-path"], value: "required", description: "Location of module dependence for generating the hash" },
      { names: ["-0", "--no-compress"], description: "Store only; use no ZIP compression" },
      { names: ["--date"], value: "required", description: "The timestamp in ISO-8601 extended offset date-time with optional time-zone format, to use for the timestamps of entries, e.g" },
      { names: ["-k", "--keep-old-files"], description: "Do not overwrite existing files" },
      { names: ["--dir"], value: "optional", description: "Directory into which the jar will be extracted" },
      { names: ["-?", "-h", "--help"], value: "optional", description: "Give this, or optionally the compatibility, help" },
      { names: ["--help-extra"], description: "Give help on extra options" },
      { names: ["--version"], description: "Print program version" },
      { names: ["-J"], value: "optional" },
      { names: ["-P"], value: "optional" }
    ]
  }
}

// The command schemas of java, javac, jar (lask spec ch. 5) for Eclipse Temurin 25.0.4,
// the release in env()'s default image.
schema_25_0_4: Map<CommandSchema> = { "java": java_command, "javac": javac_command, "jar": jar_command }

// The command schemas of the release in env()'s default image: the
// ones a command string that runs these words is checked against.
schema: Map<CommandSchema> = schema_25_0_4
