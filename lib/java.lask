  root: {
    style: "single-dash",
    intermixed: true,
    options: [
      { names: ["-Akey"], value: "optional", description: "Options to pass to annotation processors" },
      { names: ["--add-modules"], value: "required", description: "Root modules to resolve in addition to the initial modules, or all modules on the module path if <module> is ALL-MODULE-PATH" },
      { names: ["--boot-class-path", "-bootclasspath"], value: "required", description: "Override location of bootstrap class files" },
      { names: ["--class-path", "-classpath", "-cp"], value: "required", description: "Specify where to find user class files and annotation processors" },
      { names: ["-d"], value: "required", description: "Specify where to place generated class files" },
      { names: ["-deprecation"], description: "Output source locations where deprecated APIs are used" },
      { names: ["--enable-preview"], description: "Enable preview language features" },
      { names: ["-encoding"], value: "required", description: "Specify character encoding used by source files" },
      { names: ["-endorseddirs"], value: "required", description: "Override location of endorsed standards path" },
      { names: ["-extdirs"], value: "required", description: "Override location of installed extensions" },
      { names: ["-g"], description: "Generate all debugging info" },
      { names: ["-g:none"], description: "Generate no debugging info" },
      { names: ["-h"], value: "required", description: "Specify where to place generated native header files" },
      { names: ["--help", "-help", "-?"], description: "Print this help message" },
      { names: ["--help-extra", "-X"], value: "optional", prefix: true, description: "Print help on extra options Specify whether to generate class files for implicitly referenced files" },
      { names: ["-J"], value: "required", prefix: true, description: "Pass <flag> directly to the runtime system" },
      { names: ["--limit-modules"], value: "required", description: "Limit the universe of observable modules" },
      { names: ["--module"], value: "required", description: "Compile only the specified module(s), check timestamps" },
      { names: ["--module-path", "-p"], value: "required", description: "Specify where to find application modules" },
      { names: ["--module-source-path"], value: "required", description: "Specify where to find input source files for multiple modules" },
      { names: ["--module-version"], value: "required", description: "Specify version of modules that are being compiled" },
      { names: ["-nowarn"], description: "Generate only mandatory warnings" },
      { names: ["-parameters"], description: "Generate metadata for reflection on method parameters Control whether annotation processing and/or compilation is done" },
      { names: ["-processor"], value: "required", description: "Names of the annotation processors to run; bypasses default discovery process" },
      { names: ["--processor-module-path"], value: "required", description: "Specify a module path where to find annotation processors" },
      { names: ["--processor-path", "-processorpath"], value: "required", description: "Specify where to find annotation processors" },
      { names: ["-profile"], value: "required", description: "Check that API used is available in the specified profile" },
      { names: ["--release"], value: "required", description: "Compile for the specified Java SE release" },
      { names: ["-s"], value: "required", description: "Specify where to place generated source files" },
      { names: ["--source", "-source"], value: "required", description: "Provide source compatibility with the specified Java SE release" },
      { names: ["--source-path", "-sourcepath"], value: "required", description: "Specify where to find input source files" },
      { names: ["--system"], value: "required", description: "Override location of system modules" },
      { names: ["--target", "-target"], value: "required", description: "Generate class files suitable for the specified Java SE release" },
      { names: ["--upgrade-module-path"], value: "required", description: "Override location of upgradeable modules" },
      { names: ["-verbose"], description: "Output messages about what the compiler is doing" },
      { names: ["--version", "-version"], description: "Version information" },
      { names: ["-Werror"], value: "required", prefix: true, description: "Terminate compilation if warnings occur" },
      { names: ["--add-exports"], value: "required", description: "Specify a package to be considered as exported from its defining module to additional modules, or to all unnamed modules if <other-module> i" },
      { names: ["--add-reads"], value: "required", description: "Specify additional modules to be considered as required by a given module; <other-module> may be ALL-UNNAMED to require the unnamed module" },
      { names: ["--default-module-for-created-files"], value: "required", description: "Fallback target module for files created by annotation processors, if none specified or inferred" },
      { names: ["--disable-line-doc-comments"], description: "Disable support for documentation comments with lines beginning '///'" },
      { names: ["--help-lint"], description: "Print the supported keys for -Xlint" },
      { names: ["--patch-module"], value: "required", description: "Override or augment a module with classes and resources in JAR files or directories" },
      { names: ["-Xdoclint"], description: "Enable recommended checks for problems in javadoc comments Enable or disable specific checks for problems in javadoc comments, where <group>" },
      { names: ["-Xlint"], description: "Enable recommended warning categories Warning categories to enable or disable, separated by comma" },
      { names: ["-Xmaxerrs"], value: "required", description: "Set the maximum number of errors to print" },
      { names: ["-Xmaxwarns"], value: "required", description: "Set the maximum number of warnings to print Specify handling of package-info files Name and optional arguments for a plug-in to be run Speci" },
      { names: ["-Xprint"], description: "Print out a textual representation of specified types" },
      { names: ["-XprintProcessorInfo"], description: "Print information about which annotations a processor is asked to process" },
