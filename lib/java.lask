// The Eclipse Temurin JDK.

import { ToolSetup, layered_env, layered_volumes, vars } from "./common.lask"

// The Eclipse Temurin JDK, configured by its parameters.
//
// The image is #eclipse-temurin:25.0.4.1_1-jdk-noble (Java 25, an LTS
// release) unless --image names another. `lask sync` pulls and pins
// whichever image is used (lask spec 10.3); a run never pulls.
//
// @param image              The image to run; another release is passed as image = #eclipse-temurin:<tag>.
// @param java_tool_options  JAVA_TOOL_OPTIONS, which every JVM in the container reads.
// @param with               Setups of other tools this environment should also carry.
// @param extra_env          Any other variable; below --with and the named parameters.
// @return The environment, for `command { "java" } on ...` or `$[...]`.
// @example lask eval java.env --java_tool_options -Xmx2g
env(
  --image: Environment = #eclipse-temurin:25.0.4.1_1-jdk-noble,
  --java_tool_options: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env({}, extra_env, with, vars({"JAVA_TOOL_OPTIONS": java_tool_options})),
  volumes = layered_volumes(with, [])
)

// The JDK, Maven and Gradle work as they are, so their command words
// are exported, each declared on its tool's default environment.
command { "java", "javac", "jar" } on env() schema schema

