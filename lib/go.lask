internal go_opt_mod_graph_go: CommandOption = { names: ["-go"], value: "required", description: "the Go version to report the graph for" }
internal go_opt_mod_graph_x: CommandOption = { names: ["-x"], value: "optional", description: "print the commands" }
internal go_opt_mod_tidy_compat: CommandOption = { names: ["-compat"], value: "required", description: "the Go version to stay compatible with" }
internal go_opt_mod_tidy_diff: CommandOption = { names: ["-diff"], value: "optional", description: "print the changes as a diff instead of making them" }
internal go_opt_mod_tidy_e: CommandOption = { names: ["-e"], value: "optional", description: "proceed despite errors" }
internal go_opt_mod_tidy_go: CommandOption = { names: ["-go"], value: "required", description: "the Go version to write to go.mod" }
internal go_opt_mod_tidy_v: CommandOption = { names: ["-v"], value: "optional", description: "report the removed modules" }
