internal go_opt_test_fuzzminimizetime: CommandOption = { names: ["-fuzzminimizetime"], value: "required", description: "spend this long minimizing a failing input" }
internal go_opt_test_fuzztime: CommandOption = { names: ["-fuzztime"], value: "required", description: "fuzz for this long or this many iterations" }
internal go_opt_test_list: CommandOption = { names: ["-list"], value: "required", description: "list the tests, benchmarks, fuzz tests or examples matching this expression" }
internal go_opt_test_memprofile: CommandOption = { names: ["-memprofile"], value: "required" }
internal go_opt_test_memprofilerate: CommandOption = { names: ["-memprofilerate"], value: "required" }
internal go_opt_test_mutexprofile: CommandOption = { names: ["-mutexprofile"], value: "required" }
internal go_opt_test_mutexprofilefraction: CommandOption = { names: ["-mutexprofilefraction"], value: "required" }
internal go_opt_test_o: CommandOption = { names: ["-o"], value: "required", description: "compile the test binary to this file" }
internal go_opt_test_outputdir: CommandOption = { names: ["-outputdir"], value: "required", description: "place output files from profiling in this directory" }
