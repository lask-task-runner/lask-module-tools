internal go_opt_run_exec: CommandOption = { names: ["-exec"], value: "required", description: "invoke the binary through this program" }
internal go_opt_tags: CommandOption = { names: ["-tags"], value: "required", description: "a comma-separated list of build tags" }
internal go_opt_test_args: CommandOption = { names: ["-args"], stops: true, description: "pass the rest of the command line to the test binary" }
internal go_opt_test_artifacts: CommandOption = { names: ["-artifacts"], value: "optional", description: "save test artifacts in the output directory" }
internal go_opt_test_bench: CommandOption = { names: ["-bench"], value: "required", description: "run only the benchmarks matching this expression" }
internal go_opt_test_benchmem: CommandOption = { names: ["-benchmem"], value: "optional", description: "print memory allocation statistics for benchmarks" }
internal go_opt_test_benchtime: CommandOption = { names: ["-benchtime"], value: "required", description: "run each benchmark for this long or this many times" }
internal go_opt_test_blockprofile: CommandOption = { names: ["-blockprofile"], value: "required" }
internal go_opt_test_blockprofilerate: CommandOption = { names: ["-blockprofilerate"], value: "required" }
internal go_opt_test_c: CommandOption = { names: ["-c"], value: "optional", description: "compile the test binary but do not run it" }
internal go_opt_test_count: CommandOption = { names: ["-count"], value: "required", description: "run each test, benchmark and fuzz seed this many times" }
internal go_opt_test_coverprofile: CommandOption = { names: ["-coverprofile"], value: "required", description: "write a coverage profile to this file" }
internal go_opt_test_cpu: CommandOption = { names: ["-cpu"], value: "required", description: "a list of GOMAXPROCS values to run with" }
internal go_opt_test_cpuprofile: CommandOption = { names: ["-cpuprofile"], value: "required" }
internal go_opt_test_exec: CommandOption = { names: ["-exec"], value: "required", description: "run the test binary through this program" }
internal go_opt_test_failfast: CommandOption = { names: ["-failfast"], value: "optional", description: "stop after the first test failure" }
internal go_opt_test_fullpath: CommandOption = { names: ["-fullpath"], value: "optional", description: "show full file names in error messages" }
