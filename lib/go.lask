internal go_opt_mod_edit_go: CommandOption = { names: ["-go"], value: "required" }
internal go_opt_mod_edit_godebug: CommandOption = { names: ["-godebug"], value: "required" }
internal go_opt_mod_edit_ignore: CommandOption = { names: ["-ignore"], value: "required" }
