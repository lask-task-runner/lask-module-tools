internal gofmt_opt_cpuprofile: CommandOption = { names: ["-cpuprofile"], value: "required", description: "write a CPU profile to this file" }
internal gofmt_opt_d: CommandOption = { names: ["-d"], value: "optional", description: "display diffs instead of rewriting files" }
internal gofmt_opt_e: CommandOption = { names: ["-e"], value: "optional", description: "report all errors" }
internal gofmt_opt_l: CommandOption = { names: ["-l"], value: "optional", description: "list files whose formatting differs from gofmt's" }
internal gofmt_opt_r: CommandOption = { names: ["-r"], value: "required", description: "a rewrite rule, such as 'a[b:len(a)] -> a[b:]'" }
internal gofmt_opt_s: CommandOption = { names: ["-s"], value: "optional", description: "simplify code" }
internal gofmt_opt_w: CommandOption = { names: ["-w"], value: "optional", description: "write the result to the source file instead of stdout" }

// The command schema of gofmt, from `gofmt -h`.
gofmt_schema: CommandSchema = { root: { closed: true, style: "single-dash", options: [gofmt_opt_cpuprofile, gofmt_opt_d, gofmt_opt_e, gofmt_opt_l, gofmt_opt_r, gofmt_opt_s, gofmt_opt_w], description: "format Go source" } }

