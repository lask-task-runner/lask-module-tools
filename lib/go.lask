internal go_opt_v: CommandOption = { names: ["-v"], value: "optional", description: "print the names of packages as they are compiled" }
internal go_opt_version_json: CommandOption = { names: ["-json"], value: "optional", description: "print the module information in JSON" }
internal go_opt_version_m: CommandOption = { names: ["-m"], value: "optional", description: "print each executable's embedded module information" }
internal go_opt_version_v: CommandOption = { names: ["-v"], value: "optional", description: "report unrecognized files" }
