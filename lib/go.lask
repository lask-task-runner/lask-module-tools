// Go.

import { vars, mount, in_cache, git_trust, layered_env, layered_volumes, ToolSetup } from "./common.lask"

// Go, configured by its parameters.
//
// The image is #golang:1.27.1-trixie unless --image names another: Debian
// rather than Alpine, so cgo and `go test -race` find a C toolchain.
// `lask sync` pulls and pins whichever image is used (lask spec 10.3); a
// run never pulls.
//
// GOTOOLCHAIN=local keeps Go to the release its image holds: a go.mod
// that asks for a newer one fails instead of downloading it into a
// container that is thrown away. Git trusts the mounted project
// (safe.directory), so `go build` can stamp its revision. A private
// module over https takes `with = [git_setup(token = ...)]`.
//
// @param image        The image to run; another release is passed as image = #golang:<tag>.
// @param goproxy      GOPROXY.
// @param goprivate    GOPRIVATE.
// @param goflags      GOFLAGS.
// @param cgo_enabled  CGO_ENABLED, "0" or "1".
// @param goos         GOOS, to cross-compile.
// @param goarch       GOARCH, to cross-compile.
// @param cache_dir    Host directory mounted at /cache: the module cache (GOMODCACHE) and the build cache (GOCACHE).
// @param with         Setups of other tools this environment should also carry.
// @param extra_env    Any other variable; below --with and the named parameters.
// @return The environment, for `command { "go" } on ...` or `$[...]`.
// @example lask eval go --goos linux --goarch amd64
go(
  --image: Environment = #golang:1.27.1-trixie,
  --goproxy: String | Null = null,
  --goprivate: String | Null = null,
  --goflags: String | Null = null,
  --cgo_enabled: String | Null = null,
  --goos: String | Null = null,
  --goarch: String | Null = null,
  --cache_dir: String | Null = null,
  --with: Array<ToolSetup> = [],
  --extra_env: Map<String> = {}
): Runnable = runnable(image,
  env = layered_env(
    merge({"GOTOOLCHAIN": "local"}, git_trust()),
    extra_env,
    with,
    vars({
      "GOPROXY": goproxy,
      "GOPRIVATE": goprivate,
      "GOFLAGS": goflags,
      "CGO_ENABLED": cgo_enabled,
      "GOOS": goos,
      "GOARCH": goarch,
      "GOMODCACHE": in_cache(cache_dir, "mod"),
      "GOCACHE": in_cache(cache_dir, "build")
    })
  ),
  volumes = layered_volumes(with, mount(cache_dir, "/cache"))
)

// Go works as it is, so its command words are exported, declared on the
// default environment, with the schemas a command string that runs them
// is checked against (lask spec ch. 5).
command { "go", "gofmt" } on go() schema { "go": go_schema, "gofmt": gofmt_schema }

// The command schema of go (lask spec ch. 5), read from `go help` and the
// flag definitions of cmd/go in #golang:1.27.1-trixie. A boolean flag
// also takes =true or =false, so its value is "optional". test, vet,
// fix, doc and tool are not closed: test passes the flags it does not
// know to the test binary, vet and fix take each analyzer's flags, and
// doc and tool have flags their help does not list.
internal go_opt_C: CommandOption = { names: ["-C"], value: "required", description: "change to this directory before running the command; must come first" }
internal go_opt_a: CommandOption = { names: ["-a"], value: "optional", description: "force rebuilding of packages that are already up to date" }
internal go_opt_asan: CommandOption = { names: ["-asan"], value: "optional", description: "enable interoperation with address sanitizer" }
internal go_opt_asmflags: CommandOption = { names: ["-asmflags"], value: "required", description: "arguments for each go tool asm invocation" }
internal go_opt_bug_v: CommandOption = { names: ["-v"], value: "optional" }
internal go_opt_build_o: CommandOption = { names: ["-o"], value: "required", description: "write the executable or object to this file or directory" }
internal go_opt_buildmode: CommandOption = { names: ["-buildmode"], value: "required", values: ["archive", "c-archive", "c-shared", "default", "shared", "exe", "pie", "plugin"], description: "the build mode" }
internal go_opt_buildvcs: CommandOption = { names: ["-buildvcs"], value: "optional", values: ["true", "false", "auto"], description: "whether to stamp binaries with version control information" }
internal go_opt_clean_cache: CommandOption = { names: ["-cache"], value: "optional", description: "remove the entire build cache" }
internal go_opt_clean_fuzzcache: CommandOption = { names: ["-fuzzcache"], value: "optional", description: "remove the files stored for fuzz testing" }
internal go_opt_clean_i: CommandOption = { names: ["-i"], value: "optional", description: "remove the installed archive or binary" }
internal go_opt_clean_modcache: CommandOption = { names: ["-modcache"], value: "optional", description: "remove the entire module download cache" }
internal go_opt_clean_r: CommandOption = { names: ["-r"], value: "optional", description: "apply recursively to the dependencies" }
internal go_opt_clean_testcache: CommandOption = { names: ["-testcache"], value: "optional", description: "expire all test results" }
internal go_opt_compiler: CommandOption = { names: ["-compiler"], value: "required", values: ["gc", "gccgo"], description: "the compiler to use" }
internal go_opt_cover: CommandOption = { names: ["-cover"], value: "optional", description: "enable code coverage instrumentation" }
internal go_opt_covermode: CommandOption = { names: ["-covermode"], value: "required", values: ["set", "count", "atomic"], description: "the mode for coverage analysis" }
internal go_opt_coverpkg: CommandOption = { names: ["-coverpkg"], value: "required", description: "apply coverage analysis to the packages matching these patterns" }
internal go_opt_debug_actiongraph: CommandOption = { names: ["-debug-actiongraph"], value: "required" }
internal go_opt_debug_runtime_trace: CommandOption = { names: ["-debug-runtime-trace"], value: "required" }
internal go_opt_debug_trace: CommandOption = { names: ["-debug-trace"], value: "required" }
internal go_opt_env_changed: CommandOption = { names: ["-changed"], value: "optional", description: "print only the settings that differ from the default" }
internal go_opt_env_json: CommandOption = { names: ["-json"], value: "optional", description: "print in JSON" }
internal go_opt_env_u: CommandOption = { names: ["-u"], value: "optional", description: "unset the variables given" }
internal go_opt_env_w: CommandOption = { names: ["-w"], value: "optional", description: "set the variables given, as NAME=VALUE" }
internal go_opt_fmt_mod: CommandOption = { names: ["-mod"], value: "required", values: ["readonly", "vendor"], description: "the module download mode" }
internal go_opt_fmt_n: CommandOption = { names: ["-n"], value: "optional", description: "print the commands but do not run them" }
internal go_opt_fmt_x: CommandOption = { names: ["-x"], value: "optional", description: "print the commands" }
internal go_opt_gccgoflags: CommandOption = { names: ["-gccgoflags"], value: "required", description: "arguments for each gccgo compiler/linker invocation" }
internal go_opt_gcflags: CommandOption = { names: ["-gcflags"], value: "required", description: "arguments for each go tool compile invocation" }
internal go_opt_generate_run: CommandOption = { names: ["-run"], value: "required", description: "run only the directives matching this expression" }
internal go_opt_generate_skip: CommandOption = { names: ["-skip"], value: "required", description: "skip the directives matching this expression" }
internal go_opt_get_d: CommandOption = { names: ["-d"], value: "optional" }
internal go_opt_get_f: CommandOption = { names: ["-f"], value: "optional" }
internal go_opt_get_fix: CommandOption = { names: ["-fix"], value: "optional" }
internal go_opt_get_insecure: CommandOption = { names: ["-insecure"], value: "optional" }
internal go_opt_get_m: CommandOption = { names: ["-m"], value: "optional" }
internal go_opt_get_t: CommandOption = { names: ["-t"], value: "optional", description: "also get the modules needed to build tests" }
internal go_opt_get_tool: CommandOption = { names: ["-tool"], value: "optional", description: "add a tool line to go.mod" }
internal go_opt_get_u: CommandOption = { names: ["-u"], value: "optional", description: "update modules to newer releases" }
internal go_opt_installsuffix: CommandOption = { names: ["-installsuffix"], value: "required", description: "a suffix for the package installation directory" }
internal go_opt_json: CommandOption = { names: ["-json"], value: "optional", description: "emit build output in JSON" }
internal go_opt_ldflags: CommandOption = { names: ["-ldflags"], value: "required", description: "arguments for each go tool link invocation" }
internal go_opt_linkshared: CommandOption = { names: ["-linkshared"], value: "optional", description: "link against shared libraries made with -buildmode=shared" }
internal go_opt_list_compiled: CommandOption = { names: ["-compiled"], value: "optional", description: "set CompiledGoFiles" }
internal go_opt_list_deps: CommandOption = { names: ["-deps"], value: "optional", description: "also list the dependencies" }
internal go_opt_list_e: CommandOption = { names: ["-e"], value: "optional", description: "tolerate erroneous packages" }
internal go_opt_list_export: CommandOption = { names: ["-export"], value: "optional", description: "set Export to the file with export data" }
internal go_opt_list_f: CommandOption = { names: ["-f"], value: "required", description: "an alternate format, a Go template" }
internal go_opt_list_find: CommandOption = { names: ["-find"], value: "optional", description: "identify the named packages without resolving their dependencies" }
internal go_opt_list_m: CommandOption = { names: ["-m"], value: "optional", description: "list modules instead of packages" }
internal go_opt_list_retracted: CommandOption = { names: ["-retracted"], value: "optional", description: "report retracted module versions" }
internal go_opt_list_reuse: CommandOption = { names: ["-reuse"], value: "required", description: "reuse the output of an earlier -json run" }
internal go_opt_list_test: CommandOption = { names: ["-test"], value: "optional", description: "also list the test binaries" }
internal go_opt_list_u: CommandOption = { names: ["-u"], value: "optional", description: "add information about available upgrades" }
internal go_opt_list_versions: CommandOption = { names: ["-versions"], value: "optional", description: "list a module's available versions" }
