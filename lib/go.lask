internal go_opt_x: CommandOption = { names: ["-x"], value: "optional", description: "print the commands" }

go_schema: CommandSchema = {
  root: { closed: true, style: "single-dash", description: "the Go toolchain" },
  subcommands: {
    "bug": { closed: true, options: [go_opt_bug_v, go_opt_C], description: "start a bug report" },
    "build": { closed: true, options: [go_opt_C, go_opt_a, go_opt_n, go_opt_p, go_opt_race, go_opt_msan, go_opt_asan, go_opt_cover, go_opt_covermode, go_opt_coverpkg, go_opt_v, go_opt_work, go_opt_x, go_opt_asmflags, go_opt_buildmode, go_opt_buildvcs, go_opt_compiler, go_opt_gccgoflags, go_opt_gcflags, go_opt_installsuffix, go_opt_json, go_opt_ldflags, go_opt_linkshared, go_opt_mod, go_opt_modcacherw, go_opt_modfile, go_opt_overlay, go_opt_pgo, go_opt_pkgdir, go_opt_tags, go_opt_trimpath, go_opt_toolexec, go_opt_debug_actiongraph, go_opt_debug_runtime_trace, go_opt_debug_trace, go_opt_build_o], description: "compile packages and dependencies" },
    "clean": { closed: true, options: [go_opt_C, go_opt_a, go_opt_n, go_opt_p, go_opt_race, go_opt_msan, go_opt_asan, go_opt_v, go_opt_work, go_opt_x, go_opt_asmflags, go_opt_buildmode, go_opt_buildvcs, go_opt_compiler, go_opt_gccgoflags, go_opt_gcflags, go_opt_installsuffix, go_opt_ldflags, go_opt_linkshared, go_opt_mod, go_opt_modcacherw, go_opt_modfile, go_opt_overlay, go_opt_pgo, go_opt_pkgdir, go_opt_tags, go_opt_trimpath, go_opt_toolexec, go_opt_debug_actiongraph, go_opt_debug_runtime_trace, go_opt_debug_trace, go_opt_clean_i, go_opt_clean_r, go_opt_clean_cache, go_opt_clean_testcache, go_opt_clean_modcache, go_opt_clean_fuzzcache], description: "remove object files and cached files" },
    "doc": { description: "show documentation for package or symbol" },
    "env": { closed: true, options: [go_opt_env_changed, go_opt_env_json, go_opt_env_u, go_opt_env_w, go_opt_C, go_opt_n, go_opt_x], description: "print Go environment information" },
    "fix": { description: "apply fixes suggested by static checkers" },
    "fmt": { closed: true, options: [go_opt_fmt_n, go_opt_fmt_x, go_opt_fmt_mod, go_opt_C, go_opt_modcacherw, go_opt_modfile, go_opt_overlay], description: "gofmt (reformat) package sources" },
    "generate": { closed: true, options: [go_opt_n, go_opt_x, go_opt_v, go_opt_generate_run, go_opt_generate_skip, go_opt_C, go_opt_a, go_opt_asan, go_opt_asmflags, go_opt_buildmode, go_opt_buildvcs, go_opt_compiler, go_opt_debug_actiongraph, go_opt_debug_runtime_trace, go_opt_debug_trace, go_opt_gccgoflags, go_opt_gcflags, go_opt_installsuffix, go_opt_ldflags, go_opt_linkshared, go_opt_mod, go_opt_modcacherw, go_opt_modfile, go_opt_msan, go_opt_overlay, go_opt_p, go_opt_pgo, go_opt_pkgdir, go_opt_race, go_opt_tags, go_opt_toolexec, go_opt_trimpath, go_opt_work], description: "generate Go files by processing source" },
