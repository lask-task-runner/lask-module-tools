// lask-module-tools — ready-made execution environments for the tools
// a Lask task runs.
//
// Each tool is a namespace: env(...) returns its Runnable, and a tool
// whose words have command schemas has schema, the schemas of the
// release of its default image, and schema_<version>, the same by its
// version. `--image` picks the release of the image, as a head such as
// #python:3.13.5-alpine3.22; env's other keyword parameters are what the tool
// needs from the environment it runs in: the variables it reads, its
// credentials, and the host directories it has to see. A parameter left
// null sets nothing. Design: doc/design.md.
//
// This file is the public API: each tool lives in lib/<tool>.lask and
// is re-exported here as a namespace. Anything in lib/ that is not listed below stays
// out of reach of a consumer.

export { ToolSetup, home } from "./lib/common.lask"

// ---- Setups for --with, which no one tool owns ----------------------

export * as ssh from "./lib/ssh.lask"
export * as docker from "./lib/docker.lask"
export * as registry from "./lib/registry.lask"

// ---- Cloud CLIs: each needs an account, so none exports a word ------

export * as aws from "./lib/aws.lask"
export * as gcloud from "./lib/gcloud.lask"
export * as az from "./lib/az.lask"

// ---- Languages: each works as it is, so each exports its words ------

export * as python from "./lib/python.lask"
export command { "python", "python3", "pip", "pip3" } from "./lib/python.lask"

export * as node from "./lib/node.lask"
export command { "node", "npm", "npx", "corepack" } from "./lib/node.lask"

export * as go from "./lib/go.lask"
export command { "go", "gofmt" } from "./lib/go.lask"

export * as java from "./lib/java.lask"
export * as maven from "./lib/maven.lask"
export * as gradle from "./lib/gradle.lask"
export command { "java", "javac", "jar" } from "./lib/java.lask"
export command { "mvn" } from "./lib/maven.lask"
export command { "gradle" } from "./lib/gradle.lask"

export * as rust from "./lib/rust.lask"
export command { "cargo", "rustc", "rustup" } from "./lib/rust.lask"

export * as cc from "./lib/cc.lask"
export command { "gcc", "g++", "cc", "c++", "make" } from "./lib/cc.lask"

export * as ruby from "./lib/ruby.lask"
export command { "ruby", "gem", "bundle", "rake" } from "./lib/ruby.lask"

export * as dotnet from "./lib/dotnet.lask"
export command { "dotnet" } from "./lib/dotnet.lask"

export * as deno from "./lib/deno.lask"
export * as bun from "./lib/bun.lask"
export command { "deno" } from "./lib/deno.lask"
export command { "bun", "bunx" } from "./lib/bun.lask"

export * as haskell from "./lib/haskell.lask"
export command { "ghc", "ghci", "runghc", "cabal", "stack" } from "./lib/haskell.lask"

// ---- Container orchestration: a cluster needs a kubeconfig ----------

export * as kubectl from "./lib/kubectl.lask"
export * as helm from "./lib/helm.lask"
export * as kustomize from "./lib/kustomize.lask"
export * as kube from "./lib/kube.lask"
export command { "kustomize" } from "./lib/kustomize.lask"

// ---- IaC: each needs a provider's credentials -----------------------

export * as terraform from "./lib/terraform.lask"
export * as tofu from "./lib/tofu.lask"
export * as ansible from "./lib/ansible.lask"
export * as packer from "./lib/packer.lask"
export * as pulumi from "./lib/pulumi.lask"

// ---- Database clients: each needs a server --------------------------

export * as psql from "./lib/psql.lask"
export * as mysql from "./lib/mysql.lask"
export * as redis_cli from "./lib/redis_cli.lask"
export * as migrate from "./lib/migrate.lask"
export * as flyway from "./lib/flyway.lask"

// ---- Git and code hosts: each needs an identity ---------------------

export * as git from "./lib/git.lask"
export * as gh from "./lib/gh.lask"
export * as glab from "./lib/glab.lask"

// ---- Build and code generation --------------------------------------

export * as buf from "./lib/buf.lask"
export * as protoc from "./lib/protoc.lask"
export * as bazel from "./lib/bazel.lask"
export command { "buf" } from "./lib/buf.lask"
export command { "protoc" } from "./lib/protoc.lask"
export command { "bazel", "bazelisk" } from "./lib/bazel.lask"

// ---- Linters and formatters -----------------------------------------

export * as shellcheck from "./lib/shellcheck.lask"
export * as hadolint from "./lib/hadolint.lask"
export * as tflint from "./lib/tflint.lask"
export * as golangci_lint from "./lib/golangci_lint.lask"
export * as ruff from "./lib/ruff.lask"
export * as actionlint from "./lib/actionlint.lask"
export command { "shellcheck" } from "./lib/shellcheck.lask"
export command { "hadolint" } from "./lib/hadolint.lask"
export command { "tflint" } from "./lib/tflint.lask"
export command { "golangci-lint" } from "./lib/golangci_lint.lask"
export command { "ruff" } from "./lib/ruff.lask"
export command { "actionlint" } from "./lib/actionlint.lask"

// ---- Security scanners ----------------------------------------------

export * as trivy from "./lib/trivy.lask"
export * as gitleaks from "./lib/gitleaks.lask"
export * as checkov from "./lib/checkov.lask"
export * as grype from "./lib/grype.lask"
export * as syft from "./lib/syft.lask"
export * as semgrep from "./lib/semgrep.lask"
export command { "trivy" } from "./lib/trivy.lask"
export command { "gitleaks" } from "./lib/gitleaks.lask"
export command { "checkov" } from "./lib/checkov.lask"
export command { "grype" } from "./lib/grype.lask"
export command { "syft" } from "./lib/syft.lask"
export command { "semgrep" } from "./lib/semgrep.lask"

// ---- Secret managers: each needs a credential -----------------------

export * as vault from "./lib/vault.lask"
export * as sops from "./lib/sops.lask"
export * as op from "./lib/op.lask"

// ---- Everyday tools: curl, jq and the rest, in one image ------------

export * as unix from "./lib/unix.lask"
export command {
  "curl", "wget", "openssl",
  "jq", "yq", "envsubst",
  "tar", "gzip", "xz", "bzip2", "zip", "unzip",
  "rsync"
} from "./lib/unix.lask"

// ---- API, HTTP, E2E and load testing --------------------------------

// Playwright's tests run through npx, which is node's word, so it
// exports none: give it with `$[tools.playwright.env()]`.
export * as playwright from "./lib/playwright.lask"

export * as k6 from "./lib/k6.lask"
export * as grpcurl from "./lib/grpcurl.lask"
export * as newman from "./lib/newman.lask"
export * as robot from "./lib/robot.lask"
export * as ab from "./lib/ab.lask"
export command { "k6" } from "./lib/k6.lask"
export command { "grpcurl" } from "./lib/grpcurl.lask"
export command { "newman" } from "./lib/newman.lask"
export command { "robot", "rebot", "libdoc" } from "./lib/robot.lask"
export command { "ab" } from "./lib/ab.lask"
