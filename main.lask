// lask-module-tools — ready-made execution environments for the tools
// a Lask task runs.
//
// Each tool is a function returning an Environment. `--tag` picks the
// release of its image; its other keyword parameters are what the tool
// needs from the environment it runs in: the variables it reads, its
// credentials, and the host directories it has to see. A parameter left
// null sets nothing. Design: doc/design.md.
//
// This file is the public API: each tool lives in lib/<tool>.lask and
// is re-exported here. Anything in lib/ that is not listed below stays
// out of reach of a consumer.

export { ToolSetup, home } from "./lib/common.lask"

// ---- Setups for --with, which no one tool owns ----------------------

export { ssh_setup, git_setup, docker_setup, registry_setup } from "./lib/setups.lask"

// ---- Cloud CLIs: each needs an account, so none exports a word ------

export { aws, aws_setup } from "./lib/aws.lask"
export { gcloud, gcloud_setup } from "./lib/gcloud.lask"
export { az, azure_setup } from "./lib/azure.lask"

// ---- Languages: each works as it is, so each exports its words ------

export { python } from "./lib/python.lask"
export command { "python", "python3", "pip", "pip3" } from "./lib/python.lask"

export { node } from "./lib/node.lask"
export command { "node", "npm", "npx", "corepack" } from "./lib/node.lask"

export { go } from "./lib/go.lask"
export command { "go", "gofmt" } from "./lib/go.lask"

export { java, maven, gradle } from "./lib/java.lask"
export command { "java", "javac", "jar", "mvn", "gradle" } from "./lib/java.lask"

export { rust } from "./lib/rust.lask"
export command { "cargo", "rustc", "rustup" } from "./lib/rust.lask"

export { cc } from "./lib/cc.lask"
export command { "gcc", "g++", "cc", "c++", "make" } from "./lib/cc.lask"

export { ruby } from "./lib/ruby.lask"
export command { "ruby", "gem", "bundle", "rake" } from "./lib/ruby.lask"

export { dotnet } from "./lib/dotnet.lask"
export command { "dotnet" } from "./lib/dotnet.lask"

export { deno, bun } from "./lib/deno.lask"
export command { "deno", "bun", "bunx" } from "./lib/deno.lask"

export { haskell } from "./lib/haskell.lask"
export command { "ghc", "ghci", "runghc", "cabal", "stack" } from "./lib/haskell.lask"

// ---- Container orchestration: a cluster needs a kubeconfig ----------

export { kubectl, helm, kustomize, kube_setup } from "./lib/kube.lask"
export command { "kustomize" } from "./lib/kube.lask"

// ---- IaC: each needs a provider's credentials -----------------------

export { terraform, tofu } from "./lib/terraform.lask"
export { ansible } from "./lib/ansible.lask"
export { packer } from "./lib/packer.lask"
export { pulumi } from "./lib/pulumi.lask"

// ---- Database clients: each needs a server --------------------------

export { psql, pg_setup, mysql, redis_cli, migrate, flyway } from "./lib/db.lask"

// ---- Git and code hosts: each needs an identity ---------------------

export { git, gh, glab } from "./lib/git.lask"

// ---- Build and code generation --------------------------------------

export { buf, protoc, bazel } from "./lib/build.lask"
export command { "buf", "protoc", "bazel", "bazelisk" } from "./lib/build.lask"

// ---- Linters and formatters -----------------------------------------

export { shellcheck, hadolint, tflint, golangci_lint, ruff, actionlint } from "./lib/lint.lask"
export command { "shellcheck", "hadolint", "tflint", "golangci-lint", "ruff", "actionlint" } from "./lib/lint.lask"

// ---- Security scanners ----------------------------------------------

export { trivy, gitleaks, checkov, grype, syft, semgrep } from "./lib/security.lask"
export command { "trivy", "gitleaks", "checkov", "grype", "syft", "semgrep" } from "./lib/security.lask"

// ---- Secret managers: each needs a credential -----------------------

export { vault, vault_setup, sops, op } from "./lib/secrets.lask"

// ---- Everyday tools: curl, jq and the rest, in one image ------------

export { unix } from "./lib/unix.lask"
export command {
  "curl", "wget", "openssl",
  "jq", "yq", "envsubst",
  "tar", "gzip", "xz", "bzip2", "zip", "unzip",
  "rsync"
} from "./lib/unix.lask"

// ---- API, HTTP, E2E and load testing --------------------------------

// Playwright's tests run through npx, which is node's word, so it
// exports none: give it with `$[tools.playwright()]`.
export { playwright } from "./lib/playwright.lask"

export { k6, grpcurl, newman, robot, ab } from "./lib/testing.lask"
export command { "k6", "grpcurl", "newman", "robot", "rebot", "libdoc", "ab" } from "./lib/testing.lask"
